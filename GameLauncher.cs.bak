        public static Color GetSafeParentBackground(Control c, Color fallback)
        {
            if (c == null) return fallback;
            Control p = c.Parent;
            while (p != null)
            {
                if (p.BackColor != Color.Transparent && p.BackColor != Color.Empty)
                {
                    return p.BackColor;
                }
                p = p.Parent;
            }
            return fallback;
        }
    }

    #endregion

    #region Data Models & Engine

    public class GameItem
    {
        public string id { get; set; }
        public string name { get; set; }
        public string icon { get; set; }
        public string exe { get; set; }

        [ScriptIgnore]
        public string NameLower { get; set; }
        [ScriptIgnore]
        public string NameNorm { get; set; }
        [ScriptIgnore]
        public string ExeLower { get; set; }
        [ScriptIgnore]
        public string ExeNorm { get; set; }
        [ScriptIgnore]
        public string Initials { get; set; }

        public void PrecomputeSearchFields()
        {
            string n = name ?? "";
            NameLower = n.ToLowerInvariant();
            NameNorm = GameDatabase.NormalizeString(n);
            string e = exe ?? "";
            ExeLower = e.ToLowerInvariant();
            ExeNorm = GameDatabase.NormalizeString(e);
            Initials = GameDatabase.GetInitials(n);
        }

        public string GetIconUrl(int size = 64)
        {
            if (string.IsNullOrEmpty(icon) || string.IsNullOrEmpty(id)) return null;
            return string.Format("https://cdn.discordapp.com/app-icons/{0}/{1}.png?size={2}", id, icon, size);
        }

        public override string ToString()
        {
            return name ?? exe ?? "Unknown Game";
        }
    }

    public class QualifiedGameEntry
    {
        public string id { get; set; }
        public string name { get; set; }
        public string icon { get; set; }
        public string exe { get; set; }
        public int total_seconds_played { get; set; }
        public string last_played { get; set; }
    }

    public class GameCacheData
    {
        public string updated_at { get; set; }
        public List<GameItem> games { get; set; }
    }

    public class DiscordRpcClient : IDisposable
    {
        private NamedPipeClientStream _pipe;
        private readonly string _clientId;
        private bool _connected;
        private readonly object _lock = new object();
        private static readonly int _cachedPid = Process.GetCurrentProcess().Id;

        public DiscordRpcClient(string clientId)
        {
            _clientId = clientId;
        }

        public bool IsConnected
        {
            get { return _connected && _pipe != null && _pipe.IsConnected; }
        }

        public bool Connect(int timeoutMs = 1000)
        {
            if (string.IsNullOrEmpty(_clientId)) return false;
            for (int i = 0; i < 10; i++)
            {
                NamedPipeClientStream pipe = null;
                try
                {
                    pipe = new NamedPipeClientStream(".", "discord-ipc-" + i, PipeDirection.InOut);
                    pipe.Connect(timeoutMs);
                    pipe.ReadMode = PipeTransmissionMode.Byte;
                    _pipe = pipe;
                    pipe = null; // prevent dispose below since _pipe now owns it
                    if (SendHandshake())
                    {
                        _connected = true;
                        return true;
                    }
                    // Handshake rejected, close this pipe
                    try { _pipe.Dispose(); } catch { }
                    _pipe = null;
                }
                catch
                {
                    if (pipe != null)
                    {
                        try { pipe.Dispose(); } catch { }
                    }
                }
            }
            return false;
        }

        private void ReadExact(byte[] buffer, int offset, int count, int timeoutMs = 5000)
        {
            if (_pipe == null) throw new IOException("Pipe is null");
            try { _pipe.ReadTimeout = timeoutMs; } catch { }
            while (count > 0)
            {
                int n = _pipe.Read(buffer, offset, count);
                if (n == 0) throw new IOException("Pipe closed");
                offset += n;
                count -= n;
            }
        }

        private void SendPacket(int opcode, string json)
        {
            if (_pipe == null || !_pipe.IsConnected) return;
            byte[] payload = Encoding.UTF8.GetBytes(json);
            byte[] header = new byte[8];
            BitConverter.GetBytes(opcode).CopyTo(header, 0);
            BitConverter.GetBytes(payload.Length).CopyTo(header, 4);
            _pipe.Write(header, 0, 8);
            _pipe.Write(payload, 0, payload.Length);
            _pipe.Flush();
        }

        /// <summary>Reads one full frame from the pipe. Returns the opcode, or -1 on failure.</summary>
        private int ReadFrame()
        {
            try
            {
                byte[] header = new byte[8];
                ReadExact(header, 0, 8);
                int opcode = BitConverter.ToInt32(header, 0);
                int len = BitConverter.ToInt32(header, 4);
                if (len > 0 && len < 65536)
                {
                    byte[] buf = new byte[len];
                    ReadExact(buf, 0, len);
                }
                return opcode;
            }
            catch { return -1; }
        }

        /// <summary>Drains any pending response frames so the pipe buffer doesn't fill up.</summary>
        private void DrainResponses()
        {
            try
            {
                // Quick non-blocking check: set a very short timeout
                try { _pipe.ReadTimeout = 1; } catch { }
                byte[] probe = new byte[8];
                while (_pipe != null && _pipe.IsConnected)
                {
                    int n = 0;
                    try { n = _pipe.Read(probe, 0, 8); } catch { break; }
                    if (n == 0) break;
                    if (n == 8)
                    {
                        int len = BitConverter.ToInt32(probe, 4);
                        if (len > 0 && len < 65536)
                        {
                            byte[] discard = new byte[len];
                            try { ReadExact(discard, 0, len, 1000); } catch { break; }
                        }
                    }
                    else break;
                }
            }
            catch { }
        }

        private bool SendHandshake()
        {
            // Validate client_id is safe (should be numeric Discord app ID)
            foreach (char c in _clientId)
            {
                if (!char.IsDigit(c)) return false;
            }
            string json = "{\"v\":1,\"client_id\":\"" + _clientId + "\"}";
            SendPacket(0, json);
            int opcode = ReadFrame();
            // Opcode 1 = FRAME (success), Opcode 2 = CLOSE (rejected)
            return opcode == 1;
        }

        public void SetActivity(string details, string state, string largeImageKey, string largeImageText, long startEpoch)
        {
            if (!IsConnected) return;
            lock (_lock)
            {
                try
                {
                    // Drain any pending responses to prevent pipe buffer from filling
                    DrainResponses();

                    var act = new Dictionary<string, object>
                    {
                        { "cmd", "SET_ACTIVITY" },
                        { "args", new Dictionary<string, object>
                            {
                                { "pid", _cachedPid },
                                { "activity", new Dictionary<string, object>
                                    {
                                        { "details", details ?? "" },
                                        { "state", state ?? "" },
                                        { "timestamps", new Dictionary<string, object> { { "start", startEpoch } } },
                                        { "assets", new Dictionary<string, object>
                                            {
                                                { "large_image", largeImageKey ?? "" },
                                                { "large_text", largeImageText ?? "" }
                                            }
                                        },
                                        { "instance", true }
                                    }
                                }
                            }
                        },
                        { "nonce", Guid.NewGuid().ToString() }
                    };
                    JavaScriptSerializer ser = new JavaScriptSerializer();
                    string json = ser.Serialize(act);
                    SendPacket(1, json);
                }
                catch { }
            }
        }

        public void ClearActivity()
        {
            if (!IsConnected) return;
            lock (_lock)
            {
                try
                {
                    var act = new Dictionary<string, object>
                    {
                        { "cmd", "SET_ACTIVITY" },
                        { "args", new Dictionary<string, object>
                            {
                                { "pid", _cachedPid },
                                { "activity", null }
                            }
                        },
                        { "nonce", Guid.NewGuid().ToString() }
                    };
                    JavaScriptSerializer ser = new JavaScriptSerializer();
                    string json = ser.Serialize(act);
                    SendPacket(1, json);
                }
                catch { }
            }
        }

        public void Dispose()
        {
            _connected = false;
            try { ClearActivity(); } catch { }
            try
            {
                if (_pipe != null)
                {
                    _pipe.Close();
                    _pipe.Dispose();
                    _pipe = null;
                }
            }
            catch { }
        }
    }

    public class GameDatabase
    {
        private static GameDatabase _instance;
        public static GameDatabase Instance
        {
            get
            {
                if (_instance == null) _instance = new GameDatabase();
                return _instance;
            }
        }

        private List<GameItem> _games = new List<GameItem>();
        private readonly object _lock = new object();
        private bool _isUpdating = false;

        public event Action OnDatabaseUpdated;
        public event Action OnQualifiedGamesChanged;

        public int Count
        {
            get { lock (_lock) return _games.Count; }
        }

        public bool IsUpdating
        {
            get { return _isUpdating; }
        }

        public string CacheDirectory
        {
            get
            {
                string dir = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "DiscordQuestLauncher");
                if (!Directory.Exists(dir))
                {
                    try { Directory.CreateDirectory(dir); } catch { }
                }
                return dir;
            }
        }

        public string CacheFilePath
        {
            get { return Path.Combine(CacheDirectory, "games_cache.json"); }
        }

        public string QualifiedGamesFilePath
        {
            get { return Path.Combine(CacheDirectory, "qualified_games.json"); }
        }

        public string CustomGamesFilePath
        {
            get { return Path.Combine(CacheDirectory, "custom_games.json"); }
        }

        private List<GameItem> _customGames = new List<GameItem>();

        public void LoadCustomGames()
        {
            try
            {
                string path = CustomGamesFilePath;
                if (!File.Exists(path))
                {
                    path = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "custom_games.json");
                }
                if (File.Exists(path))
                {
                    string text = File.ReadAllText(path);
                    JavaScriptSerializer ser = new JavaScriptSerializer();
                    List<GameItem> items = ser.Deserialize<List<GameItem>>(text);
                    if (items != null && items.Count > 0)
                    {
                        lock (_lock)
                        {
                            _customGames = items;
                            foreach (GameItem cg in items)
                            {
                                if (cg == null || string.IsNullOrWhiteSpace(cg.name)) continue;
                                cg.PrecomputeSearchFields();

                                GameItem existing = _games.Find(x => string.Equals(x.name, cg.name, StringComparison.OrdinalIgnoreCase) ||
                                                                    (!string.IsNullOrEmpty(x.id) && x.id == cg.id));
                                if (existing != null)
                                {
                                    if (string.IsNullOrEmpty(cg.id)) cg.id = existing.id;
                                    if (string.IsNullOrEmpty(cg.icon)) cg.icon = existing.icon;
                                    if (string.IsNullOrEmpty(cg.exe)) cg.exe = existing.exe;
                                }

                                _games.RemoveAll(x => string.Equals(x.name, cg.name, StringComparison.OrdinalIgnoreCase) ||
                                                      (!string.IsNullOrEmpty(x.id) && x.id == cg.id));
                                _games.Insert(0, cg);
                            }
                        }
                    }
                }
            }
            catch { }
        }

        public void AddCustomGame(GameItem game)
        {
            if (game == null || string.IsNullOrWhiteSpace(game.name)) return;
            game.PrecomputeSearchFields();
            lock (_lock)
            {
                GameItem existing = _games.Find(x => string.Equals(x.name, game.name, StringComparison.OrdinalIgnoreCase));
                if (existing != null)
                {
                    if (string.IsNullOrEmpty(game.id)) game.id = existing.id;
                    if (string.IsNullOrEmpty(game.icon)) game.icon = existing.icon;
                }

                _customGames.RemoveAll(x => string.Equals(x.name, game.name, StringComparison.OrdinalIgnoreCase));
                _customGames.Insert(0, game);

                _games.RemoveAll(x => string.Equals(x.name, game.name, StringComparison.OrdinalIgnoreCase));
                _games.Insert(0, game);

                try
                {
                    JavaScriptSerializer ser = new JavaScriptSerializer();
                    string json = ser.Serialize(_customGames);
                    File.WriteAllText(CustomGamesFilePath, json, Encoding.UTF8);
                    try
                    {
                        string localPath = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "custom_games.json");
                        File.WriteAllText(localPath, json, Encoding.UTF8);
                    }
                    catch { }
                }
                catch { }
            }

            if (OnDatabaseUpdated != null)
            {
                try { OnDatabaseUpdated(); } catch { }
            }
        }

        public void Initialize()
        {
            bool loaded = false;

            // 1. Try AppData cache file
            if (File.Exists(CacheFilePath))
            {
                loaded = LoadCacheFromFile(CacheFilePath);
            }

            // 2. Try application directory cache file if not loaded or empty
            string localCache = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "games_cache.json");
            if (!loaded || Count == 0)
            {
                if (File.Exists(localCache))
                {
                    bool localLoaded = LoadCacheFromFile(localCache);
                    if (localLoaded)
                    {
                        loaded = true;
                        try { File.Copy(localCache, CacheFilePath, true); } catch { }
                    }
                }
            }

            // 3. Try seed abc.json in application directory if still not loaded or empty
            if (!loaded || Count == 0)
            {
                string seedFile = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "abc.json");
                if (File.Exists(seedFile))
                {
                    try
                    {
                        string seedText = File.ReadAllText(seedFile);
                        List<GameItem> seedItems = ParseDetectableApplications(seedText);
                        if (seedItems != null && seedItems.Count > 0)
                        {
                            lock (_lock) _games = seedItems;
                            SaveCache(seedItems);
                            loaded = true;
                        }
                    }
                    catch { }
                }
            }

            // Load user's custom games
            LoadCustomGames();

            // 4. Check 7-day expiration
            bool needsRefresh = false;
            if (!loaded || Count == 0)
            {
                needsRefresh = true;
            }
            else
            {
                try
                {
                    if (File.Exists(CacheFilePath))
                    {
                        DateTime lastMod = File.GetLastWriteTimeUtc(CacheFilePath);
                        if ((DateTime.UtcNow - lastMod).TotalDays >= 7)
                        {
                            needsRefresh = true;
                        }
                    }
                }
                catch { }
            }

            if (needsRefresh)
            {
                RefreshFromDiscordAsync();
            }
        }

        private bool LoadCacheFromFile(string path)
        {
            try
            {
                string text = File.ReadAllText(path);
                JavaScriptSerializer ser = new JavaScriptSerializer();
                ser.MaxJsonLength = int.MaxValue;
                GameCacheData data = ser.Deserialize<GameCacheData>(text);
                if (data != null && data.games != null && data.games.Count > 0)
                {
                    foreach (var g in data.games)
                    {
                        if (g != null) g.PrecomputeSearchFields();
                    }
                    lock (_lock) _games = data.games;
                    return true;
                }
            }
            catch { }
            return false;
        }

        public void SaveCache(List<GameItem> items)
        {
            try
            {
                GameCacheData cache = new GameCacheData
                {
                    updated_at = DateTime.UtcNow.ToString("o"),
                    games = items
                };
                JavaScriptSerializer ser = new JavaScriptSerializer();
                ser.MaxJsonLength = int.MaxValue;
                string json = ser.Serialize(cache);

                File.WriteAllText(CacheFilePath, json, Encoding.UTF8);

                string localCache = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "games_cache.json");
                try { File.WriteAllText(localCache, json, Encoding.UTF8); } catch { }
            }
            catch { }
        }

        public void RefreshFromDiscordAsync()
        {
            if (_isUpdating) return;
            _isUpdating = true;

            ThreadPool.QueueUserWorkItem(_ =>
            {
                try
                {
                    using (WebClient wc = new WebClient())
                    {
                        wc.Headers[HttpRequestHeader.UserAgent] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) DiscordQuestLauncher/2.0";
                        string json = wc.DownloadString("https://discord.com/api/v9/applications/detectable");
                        List<GameItem> parsed = ParseDetectableApplications(json);
                        if (parsed != null && parsed.Count > 0)
                        {
                            lock (_lock)
                            {
                                _games = parsed;
                            }
                            SaveCache(parsed);
                            LoadCustomGames();
                        }
                    }
                }
                catch
                {
                    lock (_lock)
                    {
                        if (_games.Count == 0)
                        {
                            string seedFile = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "abc.json");
                            if (File.Exists(seedFile))
                            {
                                try
                                {
                                    string seedText = File.ReadAllText(seedFile);
                                    _games = ParseDetectableApplications(seedText);
                                    SaveCache(_games);
                                    LoadCustomGames();
                                }
                                catch { }
                            }
                        }
                    }
                }
                finally
                {
                    _isUpdating = false;
                    if (OnDatabaseUpdated != null)
                    {
                        try { OnDatabaseUpdated(); } catch { }
                    }
                }
            });
        }

        public static string InferExecutableFromName(string name)
        {
            if (string.IsNullOrWhiteSpace(name)) return "game.exe";
            string n = name.Trim();

            // EA Sports UFC series
            Match m = Regex.Match(n, @"(?:EA\s*Sports\s*)?UFC\s*(\d+)", RegexOptions.IgnoreCase);
            if (m.Success) return "ufc" + m.Groups[1].Value + ".exe";
            if (Regex.IsMatch(n, @"(?:EA\s*Sports\s*)?UFC$", RegexOptions.IgnoreCase)) return "ufc.exe";

            // EA Sports FC (e.g. EA Sports FC 24, 25, 26, 27, 28)
            m = Regex.Match(n, @"\b(?:EA\s*Sports\s+)?FC\s*(\d+)", RegexOptions.IgnoreCase);
            if (m.Success) return "fc" + m.Groups[1].Value + ".exe";

            // FIFA series (FIFA 14, 15, 16, etc.)
            m = Regex.Match(n, @"FIFA\s*(\d+)", RegexOptions.IgnoreCase);
            if (m.Success) return "fifa" + m.Groups[1].Value + ".exe";

            // College Football
            m = Regex.Match(n, @"College\s*Football\s*(\d+)", RegexOptions.IgnoreCase);
            if (m.Success) return "cfb" + m.Groups[1].Value + ".exe";

            // Madden NFL
            m = Regex.Match(n, @"Madden\s*NFL\s*(\d+)", RegexOptions.IgnoreCase);
            if (m.Success) return "madden" + m.Groups[1].Value + ".exe";

            // NBA 2K
            m = Regex.Match(n, @"NBA\s*2K(\d+)", RegexOptions.IgnoreCase);
            if (m.Success) return "nba2k" + m.Groups[1].Value + ".exe";

            // F1 series
            m = Regex.Match(n, @"F1\s*(20\d\d|\d\d)", RegexOptions.IgnoreCase);
            if (m.Success) return "f1_" + m.Groups[1].Value + ".exe";

            // WWE 2K
            m = Regex.Match(n, @"WWE\s*2K(\d+)", RegexOptions.IgnoreCase);
            if (m.Success) return "wwe2k" + m.Groups[1].Value + ".exe";

            // NHL series
            m = Regex.Match(n, @"NHL\s*(\d+)", RegexOptions.IgnoreCase);
            if (m.Success) return "nhl" + m.Groups[1].Value + ".exe";

            // Call of Duty
            m = Regex.Match(n, @"Call\s*of\s*Duty.*Black\s*Ops\s*(\d+)", RegexOptions.IgnoreCase);
            if (m.Success) return "BlackOps" + m.Groups[1].Value + ".exe";
            m = Regex.Match(n, @"Call\s*of\s*Duty.*Modern\s*Warfare\s*(\d+)", RegexOptions.IgnoreCase);
            if (m.Success) return "ModernWarfare" + m.Groups[1].Value + ".exe";

            // General sanitized name
            string clean = Regex.Replace(n, @"[^\w]", "");
            if (!string.IsNullOrEmpty(clean))
            {
                return clean + ".exe";
            }

            return "game.exe";
        }

        public static List<GameItem> ParseDetectableApplications(string json)
        {
            JavaScriptSerializer ser = new JavaScriptSerializer();
            ser.MaxJsonLength = int.MaxValue;
            object[] rawList = ser.DeserializeObject(json) as object[];
            if (rawList == null) return new List<GameItem>();

            List<GameItem> result = new List<GameItem>(rawList.Length / 2);

            foreach (object rawObj in rawList)
            {
                Dictionary<string, object> item = rawObj as Dictionary<string, object>;
                if (item == null) continue;

                string gameTitle = item.ContainsKey("name") && item["name"] != null ? item["name"].ToString().Trim() : "";
                if (string.IsNullOrEmpty(gameTitle)) continue;

                string cleanTitle = Regex.Replace(gameTitle ?? "", @"[^\w]", "").ToLowerInvariant();

                string bestExe = null;
                int bestScore = -1000;

                if (item.ContainsKey("executables"))
                {
                    object[] exes = item["executables"] as object[];
                    if (exes != null && exes.Length > 0)
                    {
                        foreach (object exeRaw in exes)
                        {
                            Dictionary<string, object> exeObj = exeRaw as Dictionary<string, object>;
                            if (exeObj == null) continue;

                            if (!exeObj.ContainsKey("os") || !object.Equals(exeObj["os"], "win32")) continue;
                            if (!exeObj.ContainsKey("name") || exeObj["name"] == null) continue;

                            string rawName = exeObj["name"].ToString().Trim().TrimStart('>').Replace('\\', '/');
                            int slash = rawName.LastIndexOf('/');
                            string cleanExe = slash >= 0 ? rawName.Substring(slash + 1) : rawName;
                            if (string.IsNullOrWhiteSpace(cleanExe)) continue;

                            bool isLauncher = exeObj.ContainsKey("is_launcher") && object.Equals(exeObj["is_launcher"], true);
                            int score = 100;
                            if (isLauncher) score -= 50;

                            string lower = cleanExe.ToLowerInvariant();
                            if (lower.Contains("_be") || lower.Contains("_eac") || lower.Contains("easyanticheat") ||
                                lower.Contains("battleye") || lower.Contains("crash") || lower.Contains("unins") ||
                                lower.Contains("server") || lower.Contains("dedicated") || lower.Contains("editor") ||
                                lower.Contains("tools") || lower.Contains("patcher") || lower.Contains("updater") ||
                                lower.Contains("diagnostic") || lower.Contains("report"))
                            {
                                score -= 40;
                            }

                            if (lower.Contains("trial") || lower.Contains("demo") || lower.Contains("beta") ||
                                lower.Contains("playtest") || lower.Contains("showcase") || lower.Contains("benchmark"))
                            {
                                score -= 30;
                            }

                            string cleanExeNoExt = Path.GetFileNameWithoutExtension(cleanExe).ToLowerInvariant().Replace(" ", "").Replace("_", "").Replace("-", "");
                            if (cleanTitle.Length >= 3 && cleanExeNoExt.Contains(cleanTitle))
                            {
                                score += 35;
                            }
                            if (lower.Contains("shipping") || lower.Contains("vulkan") || lower.Contains("dx11") || lower.Contains("dx12") || lower.Contains("x64"))
                            {
                                score += 5;
                            }

                            if (score > bestScore)
                            {
                                bestScore = score;
                                bestExe = cleanExe;
                            }
                        }
                    }
                }

                if (string.IsNullOrEmpty(bestExe))
                {
                    bestExe = InferExecutableFromName(gameTitle);
                }

                if (!string.IsNullOrEmpty(bestExe))
                {
                    string id = item.ContainsKey("id") && item["id"] != null ? item["id"].ToString() : "";
                    string icon = "";
                    if (item.ContainsKey("icon_hash") && item["icon_hash"] != null) icon = item["icon_hash"].ToString();
                    else if (item.ContainsKey("icon") && item["icon"] != null) icon = item["icon"].ToString();

                    GameItem gi = new GameItem
                    {
                        id = id,
                        name = gameTitle,
                        icon = icon,
                        exe = bestExe
                    };
                    gi.PrecomputeSearchFields();
                    result.Add(gi);
                }
            }

            return result;
        }

        public static string NormalizeString(string s)
        {
            if (string.IsNullOrEmpty(s)) return "";
            StringBuilder sb = new StringBuilder(s.Length);
            for (int i = 0; i < s.Length; i++)
            {
                char c = s[i];
                if (char.IsLetterOrDigit(c))
                {
                    sb.Append(char.ToLowerInvariant(c));
                }
            }
            return sb.ToString();
        }

        public static string GetInitials(string s)
        {
            if (string.IsNullOrEmpty(s)) return "";
            StringBuilder sb = new StringBuilder();
            bool inWord = false;
            for (int i = 0; i < s.Length; i++)
            {
                char c = s[i];
                if (char.IsLetterOrDigit(c))
                {
                    if (!inWord)
                    {
                        sb.Append(char.ToLowerInvariant(c));
                        inWord = true;
                    }
                }
                else
                {
                    inWord = false;
                }
            }
            return sb.ToString();
        }

        public static string CleanSearchQuery(string query)
        {
            if (string.IsNullOrWhiteSpace(query)) return "";
            string s = query.Trim();
            // Remove symbols like ™, ®, ©
            s = Regex.Replace(s, @"[\u2122\u00ae\u00a9]", " ");
            // Remove trailing/leading whole-word "quest" or "quests"
            s = Regex.Replace(s, @"\bquests?\b", " ", RegexOptions.IgnoreCase);
            s = Regex.Replace(s, @"\s+", " ").Trim();
            return s;
        }

        public static List<string> ExpandAliases(string qLower)
        {
            List<string> list = new List<string>();
            string clean = CleanSearchQuery(qLower).ToLowerInvariant();
            if (string.IsNullOrEmpty(clean)) clean = qLower;

            // EA Sports FC / FIFA
            if (clean.Contains("ea fc") || clean.Contains("eafc") || clean.StartsWith("fc ") || clean.StartsWith("fifa ") || clean.Contains("fc2") || clean.Contains("fifa2"))
            {
                list.Add(Regex.Replace(clean, @"\bea\s*fc\b|\beafc\b", "ea sports fc").Trim());
            }
            Match mFifa = Regex.Match(clean, @"fifa\s*(2[4-9]|[3-9]\d)", RegexOptions.IgnoreCase);
            if (mFifa.Success)
            {
                list.Add("ea sports fc " + mFifa.Groups[1].Value);
            }
            Match mFc = Regex.Match(clean, @"(?:^|\s)fc\s*(\d+)", RegexOptions.IgnoreCase);
            if (mFc.Success)
            {
                list.Add("ea sports fc " + mFc.Groups[1].Value);
            }
            if (clean == "fc27" || clean == "fc 27" || clean == "ea fc 27" || clean == "eafc 27" || clean == "fifa 27" || clean == "fifa27")
            {
                list.Add("ea sports fc 27");
            }

            // Acronyms & Popular Names
            if (qLower == "wuwa") list.Add("wuthering waves");
            else if (qLower == "zzz") list.Add("zenless zone zero");
            else if (qLower == "wwm") list.Add("where winds meet");
            else if (qLower == "hsr") list.Add("honkai: star rail");
            else if (qLower == "genshin") list.Add("genshin impact");
            else if (qLower == "poe") list.Add("path of exile");
            else if (qLower == "r6" || qLower == "siege") list.Add("rainbow six");
            else if (qLower == "valo") list.Add("valorant");
            else if (qLower == "ow" || qLower == "ow2") list.Add("overwatch");
            else if (qLower == "cs" || qLower == "cs2" || qLower == "csgo") list.Add("counter-strike");
            else if (qLower == "wf") list.Add("warframe");
            else if (qLower == "mc") list.Add("minecraft");
            else if (qLower == "tarkov") list.Add("escape from tarkov");
            else if (qLower == "cod") list.Add("call of duty");
            else if (qLower.StartsWith("cod ")) list.Add("call of duty " + qLower.Substring(4));
            else if (qLower.StartsWith("bo") && qLower.Length > 2 && char.IsDigit(qLower[2])) list.Add("black ops " + qLower.Substring(2));
            else if (qLower.StartsWith("mw") && qLower.Length > 2 && char.IsDigit(qLower[2])) list.Add("modern warfare " + qLower.Substring(2));
            else if (qLower == "gta") list.Add("grand theft auto");
            else if (qLower == "gta 5" || qLower == "gta5" || qLower == "gta v") list.Add("grand theft auto v");
            else if (qLower == "gta 6" || qLower == "gta6" || qLower == "gta vi") list.Add("grand theft auto vi");
            else if (qLower == "gta 4" || qLower == "gta4" || qLower == "gta iv") list.Add("grand theft auto iv");
            else if (qLower == "gta sa") list.Add("grand theft auto: san andreas");
            else if (qLower == "gta vc") list.Add("grand theft auto: vice city");
            else if (qLower.StartsWith("gta ")) list.Add("grand theft auto " + qLower.Substring(4));
            else if (qLower.StartsWith("civ ") && qLower.Length > 4 && char.IsDigit(qLower[4])) list.Add("civilization");

            return list;
        }

        private class ScoredGame
        {
            public GameItem Game;
            public int Score;
            public int NameLength;
        }

        private static bool AllTokensMatch(string text, string[] tokens)
        {
            for (int i = 0; i < tokens.Length; i++)
            {
                if (text.IndexOf(tokens[i], StringComparison.Ordinal) < 0) return false;
            }
            return true;
        }

        private static bool AllTokensMatchAcross(string text1, string text2, string[] tokens)
        {
            for (int i = 0; i < tokens.Length; i++)
            {
                if (text1.IndexOf(tokens[i], StringComparison.Ordinal) < 0 &&
                    text2.IndexOf(tokens[i], StringComparison.Ordinal) < 0)
                {
                    return false;
                }
            }
            return true;
        }

        public List<GameItem> Search(string query, int limit = 50)
        {
            if (string.IsNullOrWhiteSpace(query))
            {
                return new List<GameItem>();
            }

            string rawQ = query.Trim();
            string cleanQ = CleanSearchQuery(rawQ);
            string q = !string.IsNullOrEmpty(cleanQ) ? cleanQ : rawQ;
            string qLower = q.ToLowerInvariant();
            string qNorm = NormalizeString(q);
            string spaceQ = " " + qLower;

            List<string> aliases = ExpandAliases(qLower);
            if (!string.IsNullOrEmpty(rawQ) && rawQ != q)
            {
                foreach (string a in ExpandAliases(rawQ.ToLowerInvariant()))
                {
                    if (!aliases.Contains(a)) aliases.Add(a);
                }
            }

            string[] tokens = qLower.Split(new[] { ' ', '-', ':', '_', '.', '/', '\\', ',', '(', ')' }, StringSplitOptions.RemoveEmptyEntries);

            List<ScoredGame> scored = new List<ScoredGame>();

            lock (_lock)
            {
                for (int i = 0; i < _games.Count; i++)
                {
                    GameItem g = _games[i];
                    if (g == null) continue;

                    string nameLower = g.NameLower ?? (g.NameLower = (g.name ?? "").ToLowerInvariant());
                    string nameNorm = g.NameNorm ?? (g.NameNorm = NormalizeString(g.name ?? ""));
                    string exeLower = g.ExeLower ?? (g.ExeLower = (g.exe ?? "").ToLowerInvariant());
                    string exeNorm = g.ExeNorm ?? (g.ExeNorm = NormalizeString(g.exe ?? ""));
                    string initials = g.Initials ?? (g.Initials = GetInitials(g.name ?? ""));
                    string name = g.name ?? "";

                    int score = 0;

                    // 1. Exact full name match
                    if (nameLower == qLower)
                    {
                        score = 1000;
                    }
                    // 2. Exact alias match
                    else if (aliases.Count > 0 && aliases.Contains(nameLower))
                    {
                        score = 980;
                    }
                    // 3. Exact normalized name match
                    else if (!string.IsNullOrEmpty(qNorm) && nameNorm == qNorm)
                    {
                        score = 950;
                    }
                    // 4. Exact exe match (e.g. fc27.exe or fc27, gta5.exe)
                    else if (exeLower == qLower || (!qLower.EndsWith(".exe") && exeLower == qLower + ".exe") || (!string.IsNullOrEmpty(qNorm) && (exeNorm == qNorm || exeNorm == qNorm + "exe")))
                    {
                        score = 940;
                    }
                    // 5. Name starts with query
                    else if (nameLower.StartsWith(qLower, StringComparison.Ordinal))
                    {
                        score = 900;
                    }
                    // 6. Name starts with an alias
                    else if (aliases.Count > 0 && aliases.Exists(a => nameLower.StartsWith(a, StringComparison.Ordinal) && (nameLower.Length == a.Length || !char.IsLetter(nameLower[a.Length]))))
                    {
                        score = 880;
                    }
                    // 7. Word in name starts with query
                    else if (nameLower.IndexOf(spaceQ, StringComparison.Ordinal) >= 0)
                    {
                        score = 820;
                    }
                    // 8. Alias substring in name
                    else if (aliases.Count > 0 && aliases.Exists(a => nameLower.IndexOf(a, StringComparison.Ordinal) >= 0))
                    {
                        score = 800;
                    }
                    // 9. All tokens present in name
                    else if (tokens.Length > 1 && AllTokensMatch(nameLower, tokens))
                    {
                        score = 750;
                    }
                    // 10. All tokens present across name and exe
                    else if (tokens.Length > 1 && AllTokensMatchAcross(nameLower, exeLower, tokens))
                    {
                        score = 700;
                    }
                    // 11. Normalized substring match (e.g. fc27 in easportsfc27)
                    else if (!string.IsNullOrEmpty(qNorm) && qNorm.Length >= 3 && nameNorm.IndexOf(qNorm, StringComparison.Ordinal) >= 0)
                    {
                        score = 650;
                    }
                    // 12. Initials match (e.g. eafc matches EA Sports FC)
                    else if (!string.IsNullOrEmpty(qNorm) && qNorm.Length >= 2 && (initials == qNorm || initials.StartsWith(qNorm, StringComparison.Ordinal)))
                    {
                        score = 600;
                    }
                    // 13. Exe starts with or contains query
                    else if (exeLower.StartsWith(qLower, StringComparison.Ordinal))
                    {
                        score = 550;
                    }
                    else if (exeLower.IndexOf(qLower, StringComparison.Ordinal) >= 0 || (!string.IsNullOrEmpty(qNorm) && qNorm.Length >= 3 && exeNorm.IndexOf(qNorm, StringComparison.Ordinal) >= 0))
                    {
                        score = 500;
                    }
                    // 14. Substring in name
                    else if (nameLower.IndexOf(qLower, StringComparison.Ordinal) >= 0)
                    {
                        score = 400;
                    }

                    if (score > 0)
                    {
                        scored.Add(new ScoredGame
                        {
                            Game = g,
                            Score = score,
                            NameLength = name.Length
                        });
                    }
                }
            }

            // Sort by Score DESC, then NameLength ASC
            scored.Sort((a, b) =>
            {
                int cmp = b.Score.CompareTo(a.Score);
                if (cmp != 0) return cmp;
                return a.NameLength.CompareTo(b.NameLength);
            });

            int resultCount = Math.Min(limit, scored.Count);
            List<GameItem> results = new List<GameItem>(resultCount);
            for (int i = 0; i < resultCount; i++)
            {
                results.Add(scored[i].Game);
            }
            return results;
        }

        public GameItem FindExactGame(string nameOrExe)
        {
            if (string.IsNullOrWhiteSpace(nameOrExe)) return null;
            string raw = nameOrExe.Trim();
            string clean = CleanSearchQuery(raw);
            if (string.IsNullOrEmpty(clean)) clean = raw;
            string cleanLower = clean.ToLowerInvariant();
            string cleanNorm = NormalizeString(clean);
            string rawNorm = NormalizeString(raw);

            lock (_lock)
            {
                // 1. Direct name / exe match
                foreach (GameItem g in _games)
                {
                    if (string.Equals(g.name, raw, StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(g.name, clean, StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(g.exe, raw, StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(g.exe, clean, StringComparison.OrdinalIgnoreCase))
                    {
                        return g;
                    }
                    // Try extension-stripped comparison (guarded against invalid path chars)
                    try
                    {
                        if (string.Equals(Path.GetFileNameWithoutExtension(g.exe), Path.GetFileNameWithoutExtension(raw), StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(Path.GetFileNameWithoutExtension(g.exe), Path.GetFileNameWithoutExtension(clean), StringComparison.OrdinalIgnoreCase))
                        {
                            return g;
                        }
                    }
                    catch { }
                }

                // 2. Normalized match (e.g. 'eafc27' or 'fc27' or 'ea sports fc 27')
                if (!string.IsNullOrEmpty(cleanNorm) || !string.IsNullOrEmpty(rawNorm))
                {
                    foreach (GameItem g in _games)
                    {
                        string gNameNorm = NormalizeString(g.name);
                        string gExeNorm = NormalizeString(g.exe);
                        if (gNameNorm == cleanNorm || gExeNorm == cleanNorm || gNameNorm == rawNorm || gExeNorm == rawNorm)
                        {
                            return g;
                        }
                    }
                }

                // 3. Known alias search (e.g. 'ea fc 27' -> 'ea sports fc 27')
                List<string> aliases = ExpandAliases(cleanLower);
                if (aliases.Count > 0)
                {
                    foreach (GameItem g in _games)
                    {
                        string gLower = (g.name ?? "").ToLowerInvariant();
                        if (aliases.Contains(gLower))
                        {
                            return g;
                        }
                    }
                }
            }
            return null;
        }

        private List<QualifiedGameEntry> _qualifiedGamesCache = null;

        public static void SafeAtomicWriteText(string destinationPath, string text)
        {
            try
            {
                string dir = Path.GetDirectoryName(destinationPath);
                if (!Directory.Exists(dir)) Directory.CreateDirectory(dir);
                string tempPath = destinationPath + "." + Guid.NewGuid().ToString("N") + ".tmp";
                File.WriteAllText(tempPath, text, Encoding.UTF8);
                if (File.Exists(destinationPath))
                {
                    string backupPath = destinationPath + ".bak";
                    try { File.Copy(destinationPath, backupPath, true); } catch { }
                }
                File.Copy(tempPath, destinationPath, true);
                try { File.Delete(tempPath); } catch { }
            }
            catch { }
        }

        public List<QualifiedGameEntry> GetQualifiedGames()
        {
            lock (_lock)
            {
                if (_qualifiedGamesCache != null)
                {
                    return new List<QualifiedGameEntry>(_qualifiedGamesCache);
                }

                string path = QualifiedGamesFilePath;
                if (!File.Exists(path))
                {
                    path = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "qualified_games.json");
                }
                if (File.Exists(path))
                {
                    // Retry up to 3 times in case another process is writing
                    for (int retry = 0; retry < 3; retry++)
                    {
                        try
                        {
                            string text = File.ReadAllText(path);
                            if (!string.IsNullOrWhiteSpace(text))
                            {
                                JavaScriptSerializer ser = new JavaScriptSerializer();
                                List<QualifiedGameEntry> list = ser.Deserialize<List<QualifiedGameEntry>>(text);
                                if (list != null)
                                {
                                    _qualifiedGamesCache = list;
                                    return new List<QualifiedGameEntry>(list);
                                }
                            }
                            break;
                        }
                        catch (IOException)
                        {
                            Thread.Sleep(50);
                        }
                        catch { break; }
                    }
                }
                _qualifiedGamesCache = new List<QualifiedGameEntry>();
                return new List<QualifiedGameEntry>();
            }
        }

        public void RecordQualifiedGame(GameItem game, int sessionSeconds)
        {
            if (game == null || sessionSeconds < 120) return;
            try
            {
                lock (_lock)
                {
                    List<QualifiedGameEntry> list = GetQualifiedGames();
                    QualifiedGameEntry found = null;
                    foreach (var item in list)
                    {
                        if (string.Equals(item.name, game.name, StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(item.exe, game.exe, StringComparison.OrdinalIgnoreCase))
                        {
                            found = item;
                            break;
                        }
                    }

                    if (found == null)
                    {
                        found = new QualifiedGameEntry
                        {
                            id = game.id ?? "",
                            name = game.name ?? "",
                            icon = game.icon ?? "",
                            exe = game.exe ?? "",
                            total_seconds_played = sessionSeconds,
                            last_played = DateTime.UtcNow.ToString("o")
                        };
                        list.Insert(0, found);
                    }
                    else
                    {
                        found.total_seconds_played += sessionSeconds;
                        found.last_played = DateTime.UtcNow.ToString("o");
                        if (!string.IsNullOrEmpty(game.icon)) found.icon = game.icon;
                        if (!string.IsNullOrEmpty(game.id)) found.id = game.id;
                        list.Remove(found);
                        list.Insert(0, found);
                    }

                    if (list.Count > 8) list = list.GetRange(0, 8);
                    _qualifiedGamesCache = new List<QualifiedGameEntry>(list);

                    JavaScriptSerializer ser = new JavaScriptSerializer();
                    string json = ser.Serialize(list);
                    SafeAtomicWriteText(QualifiedGamesFilePath, json);

                    try
                    {
                        string localPath = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "qualified_games.json");
                        SafeAtomicWriteText(localPath, json);
                    }
                    catch { }
                }

                if (OnQualifiedGamesChanged != null)
                {
                    try { OnQualifiedGamesChanged(); } catch { }
                }

                SaveLastSimulatedGame(game);
            }
            catch { }
        }

        public string LastSimulatedFilePath
        {
            get { return Path.Combine(CacheDirectory, "last_simulated.json"); }
        }

        public GameItem GetLastSimulatedGame()
        {
            try
            {
                string path = LastSimulatedFilePath;
                if (!File.Exists(path))
                {
                    path = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "last_simulated.json");
                }
                if (File.Exists(path))
                {
                    string json = File.ReadAllText(path);
                    if (!string.IsNullOrWhiteSpace(json))
                    {
                        JavaScriptSerializer ser = new JavaScriptSerializer();
                        GameItem item = ser.Deserialize<GameItem>(json);
                        if (item != null && (!string.IsNullOrEmpty(item.name) || !string.IsNullOrEmpty(item.exe)))
                        {
                            return item;
                        }
                    }
                }
            }
            catch { }

            // Fallback to the most recent game from qualified games if available
            try
            {
                var qualified = GetQualifiedGames();
                if (qualified != null && qualified.Count > 0 && qualified[0] != null)
                {
                    var q = qualified[0];
                    return new GameItem
                    {
                        id = q.id,
                        name = q.name,
                        icon = q.icon,
                        exe = q.exe
                    };
                }
            }
            catch { }

            return null;
        }

        public void SaveLastSimulatedGame(GameItem game)
        {
            if (game == null) return;
            try
            {
                JavaScriptSerializer ser = new JavaScriptSerializer();
                string json = ser.Serialize(game);
                SafeAtomicWriteText(LastSimulatedFilePath, json);
                try
                {
                    string localPath = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "last_simulated.json");
                    SafeAtomicWriteText(localPath, json);
                }
                catch { }
            }
            catch { }
        }
    }

    public class IconCache
    {
        private static IconCache _instance;
        public static IconCache Instance
        {
            get
            {
                if (_instance == null) _instance = new IconCache();
                return _instance;
            }
        }

        private readonly Dictionary<string, Image> _memoryCache = new Dictionary<string, Image>();
        private readonly HashSet<string> _inFlight = new HashSet<string>();
        private readonly object _lock = new object();

        private Image _fallbackGamepad34;
        private Image _fallbackGamepad44;
        private Image _fallbackGamepad54;

        public string IconDirectory
        {
            get
            {
                string dir = Path.Combine(GameDatabase.Instance.CacheDirectory, "icons");
                if (!Directory.Exists(dir))
                {
                    try { Directory.CreateDirectory(dir); } catch { }
                }
                return dir;
            }
        }

        public Image GetIcon(GameItem game, int size, Action<Image> onLoaded = null)
        {
            if (game == null || string.IsNullOrEmpty(game.id) || string.IsNullOrEmpty(game.icon))
            {
                return GetFallbackGamepadIcon(size);
            }

            string key = string.Format("{0}_{1}_{2}", game.id, game.icon, size);
            lock (_lock)
            {
                if (_memoryCache.ContainsKey(key))
                {
                    return _memoryCache[key];
                }
            }

            // Check disk cache
            string diskPath = Path.Combine(IconDirectory, string.Format("{0}_{1}.png", game.id, game.icon));
            if (File.Exists(diskPath))
            {
                try
                {
                    byte[] bytes = File.ReadAllBytes(diskPath);
                    using (MemoryStream ms = new MemoryStream(bytes))
                    using (Image src = Image.FromStream(ms))
                    {
                        Image rounded = CreateRoundedThumbnail(src, size, 8);
                        lock (_lock)
                        {
                            _memoryCache[key] = rounded;
                        }
                        return rounded;
                    }
                }
                catch { }
            }

            // Background download
            if (onLoaded != null)
            {
                lock (_lock)
                {
                    if (!_inFlight.Contains(key))
                    {
                        _inFlight.Add(key);
                        ThreadPool.QueueUserWorkItem(_ =>
                        {
                            try
                            {
                                string url = game.GetIconUrl(size >= 44 ? 128 : 64);
                                if (!string.IsNullOrEmpty(url))
                                {
                                    using (WebClient wc = new WebClient())
                                    {
                                        wc.Headers[HttpRequestHeader.UserAgent] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64)";
                                        byte[] data = wc.DownloadData(url);
                                        try { File.WriteAllBytes(diskPath, data); } catch { }

                                        using (MemoryStream ms = new MemoryStream(data))
                                        using (Image src = Image.FromStream(ms))
                                        {
                                            Image rounded = CreateRoundedThumbnail(src, size, 8);
                                            lock (_lock)
                                            {
                                                _memoryCache[key] = rounded;
                                                _inFlight.Remove(key);
                                            }
                                            onLoaded(rounded);
                                            return;
                                        }
                                    }
                                }
                            }
                            catch { }

                            // Negative cache: store fallback so we don't retry on every repaint
                            lock (_lock)
                            {
                                _inFlight.Remove(key);
                                if (!_memoryCache.ContainsKey(key))
                                {
                                    _memoryCache[key] = GetFallbackGamepadIcon(size);
                                }
                            }
                        });
                    }
                }
            }

            return GetFallbackGamepadIcon(size);
        }

        public static Bitmap CreateRoundedThumbnail(Image src, int size, int radius)
        {
            Bitmap bmp = new Bitmap(size, size, PixelFormat.Format32bppArgb);
            using (Graphics g = Graphics.FromImage(bmp))
            {
                g.SmoothingMode = SmoothingMode.AntiAlias;
                g.InterpolationMode = InterpolationMode.HighQualityBicubic;
                g.PixelOffsetMode = PixelOffsetMode.HighQuality;
                g.Clear(Color.Transparent);

                Rectangle rect = new Rectangle(0, 0, size, size);
                using (GraphicsPath path = Program.GetRoundedPath(rect, radius))
                {
                    // Dark container background inside the rounded shape
                    using (SolidBrush darkBg = new SolidBrush(Color.FromArgb(24, 25, 28)))
                    {
                        g.FillPath(darkBg, path);
                    }

                    g.SetClip(path);
                    g.DrawImage(src, 0, 0, size, size);
                    g.ResetClip();

                    using (Pen p = new Pen(Color.FromArgb(45, 255, 255, 255), 1f))
                    {
                        g.DrawPath(p, path);
                    }
                }
            }
            return bmp;
        }

        public Image GetFallbackGamepadIcon(int size)
        {
            if (size <= 36 && _fallbackGamepad34 != null) return _fallbackGamepad34;
            if (size > 36 && size <= 46 && _fallbackGamepad44 != null) return _fallbackGamepad44;
            if (size > 46 && _fallbackGamepad54 != null) return _fallbackGamepad54;

            Bitmap bmp = new Bitmap(size, size, PixelFormat.Format32bppArgb);
            using (Graphics g = Graphics.FromImage(bmp))
            {
                g.SmoothingMode = SmoothingMode.AntiAlias;
                g.Clear(Color.Transparent);

                Rectangle rect = new Rectangle(0, 0, size, size);
                using (GraphicsPath clip = Program.GetRoundedPath(rect, 8))
                {
                    using (SolidBrush bg = new SolidBrush(Color.FromArgb(43, 45, 49)))
                    {
                        g.FillPath(bg, clip);
                    }
                    using (Pen bp = new Pen(Color.FromArgb(56, 58, 64), 1f))
                    {
                        g.DrawPath(bp, clip);
                    }
                }

                float s = size / 64.0f;
                RectangleF body = new RectangleF(8 * s, 18 * s, 48 * s, 30 * s);
                using (GraphicsPath p = new GraphicsPath())
                {
                    float r = 10 * s;
                    p.AddArc(body.X, body.Y, r * 2, r * 2, 180, 90);
                    p.AddArc(body.Right - r * 2, body.Y, r * 2, r * 2, 270, 90);
                    p.AddArc(body.Right - r * 2, body.Bottom - r * 2, r * 2, r * 2, 0, 90);
                    p.AddArc(body.X, body.Bottom - r * 2, r * 2, r * 2, 90, 90);
                    p.CloseFigure();

                    using (SolidBrush b = new SolidBrush(Color.FromArgb(54, 57, 63)))
                    {
                        g.FillPath(b, p);
                    }
                    using (Pen pen = new Pen(Color.FromArgb(88, 101, 242), 1.5f * s))
                    {
                        g.DrawPath(pen, p);
                    }
                }

                // D-Pad
                using (SolidBrush btn = new SolidBrush(Color.FromArgb(219, 222, 225)))
                {
                    g.FillRectangle(btn, 16 * s, 31 * s, 10 * s, 4 * s);
                    g.FillRectangle(btn, 19 * s, 28 * s, 4 * s, 10 * s);
                }

                // Action buttons
                using (SolidBrush btn = new SolidBrush(Color.FromArgb(219, 222, 225)))
                {
                    float bs = 3.5f * s;
                    g.FillEllipse(btn, 42 * s, 27 * s, bs, bs);
                    g.FillEllipse(btn, 38 * s, 31 * s, bs, bs);
                    g.FillEllipse(btn, 46 * s, 31 * s, bs, bs);
                    g.FillEllipse(btn, 42 * s, 35 * s, bs, bs);
                }

                // Thumbsticks
                using (SolidBrush thumb = new SolidBrush(Color.FromArgb(88, 101, 242)))
                {
                    float ts = 6 * s;
                    g.FillEllipse(thumb, 24 * s, 34 * s, ts, ts);
                    g.FillEllipse(thumb, 34 * s, 34 * s, ts, ts);
                }
            }

            if (size <= 36) _fallbackGamepad34 = bmp;
            else if (size <= 46) _fallbackGamepad44 = bmp;
            else _fallbackGamepad54 = bmp;

            return bmp;
        }
    }

    #endregion

    #region Custom Professional Controls

    public class GradientPanel : Panel
    {
        public Color GradientColor1 { get; set; }
        public Color GradientColor2 { get; set; }
        public float GradientAngle { get; set; }
        public int BorderRadius { get; set; }
        public Color BorderColor { get; set; }
        public float BorderWidth { get; set; }

        public GradientPanel()
        {
            this.GradientColor1 = Theme.AccentPrimary;
            this.GradientColor2 = Theme.AccentPurple;
            this.GradientAngle = 135f;
            this.BorderRadius = 6;
            this.BorderColor = Color.Transparent;
            this.BorderWidth = 0f;
            this.DoubleBuffered = true;
            this.SetStyle(ControlStyles.UserPaint | ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer, true);
        }

        protected override void OnPaint(PaintEventArgs e)
        {
            e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
            Color parentBg = Theme.GetSafeParentBackground(this, Theme.BgBase);
            using (SolidBrush pb = new SolidBrush(parentBg))
            {
                e.Graphics.FillRectangle(pb, ClientRectangle);
            }

            Rectangle rect = new Rectangle(0, 0, Width - 1, Height - 1);
            using (GraphicsPath path = Program.GetRoundedPath(rect, BorderRadius))
            {
                using (LinearGradientBrush brush = new LinearGradientBrush(rect, GradientColor1, GradientColor2, GradientAngle))
                {
                    e.Graphics.FillPath(brush, path);
                }

                if (BorderWidth > 0 && BorderColor != Color.Transparent)
                {
                    using (Pen p = new Pen(BorderColor, BorderWidth))
                    {
                        e.Graphics.DrawPath(p, path);
                    }
                }
            }
        }
    }

    public class ModernCard : Panel
    {
        public int Radius { get; set; }
        public Color BorderColor { get; set; }
        public float BorderWidth { get; set; }
        public bool ShowTopAccent { get; set; }
        public Color AccentColor1 { get; set; }
        public Color AccentColor2 { get; set; }

        public ModernCard()
        {
            this.Radius = 14;
            this.BorderColor = Theme.BorderSubtle;
            this.BorderWidth = 1f;
            this.ShowTopAccent = false;
            this.AccentColor1 = Theme.AccentPrimary;
            this.AccentColor2 = Theme.AccentPurple;
            this.BackColor = Theme.BgCard;
            this.DoubleBuffered = true;
            this.SetStyle(ControlStyles.UserPaint | ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer, true);
        }

        protected override void OnPaint(PaintEventArgs e)
        {
            e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
            Color parentBg = Theme.GetSafeParentBackground(this, Theme.BgBase);
            using (SolidBrush pb = new SolidBrush(parentBg))
            {
                e.Graphics.FillRectangle(pb, ClientRectangle);
            }

            Rectangle rect = new Rectangle(0, 0, Width - 1, Height - 1);
            using (GraphicsPath path = Program.GetRoundedPath(rect, Radius))
            {
                using (SolidBrush bgBrush = new SolidBrush(this.BackColor))
                {
                    e.Graphics.FillPath(bgBrush, path);
                }

                if (ShowTopAccent && Width > 4 && Height > 4)
                {
                    e.Graphics.SetClip(path);
                    Rectangle accentRect = new Rectangle(0, 0, Width, 3);
                    using (LinearGradientBrush gradBrush = new LinearGradientBrush(
                        new Rectangle(0, 0, Width, 4), AccentColor1, AccentColor2, 0f))
                    {
                        e.Graphics.FillRectangle(gradBrush, accentRect);
                    }
                    e.Graphics.ResetClip();
                }

                if (BorderWidth > 0 && BorderColor != Color.Transparent)
                {
                    using (Pen borderPen = new Pen(BorderColor, BorderWidth))
                    {
                        e.Graphics.DrawPath(borderPen, path);
                    }
                }
            }
        }
    }

