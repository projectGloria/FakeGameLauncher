    {
    }

    public class ModernButton : Button
    {
        public int BorderRadius { get; set; }
        public Color NormalColor1 { get; set; }
        public Color NormalColor2 { get; set; }
        public Color HoverColor1 { get; set; }
        public Color HoverColor2 { get; set; }
        public Color PressedColor1 { get; set; }
        public Color PressedColor2 { get; set; }
        public bool UseGradient { get; set; }
        public bool ShowShimmer { get; set; }

        private bool isHovered = false;
        private bool isPressed = false;
        private float shimmerPos = -1f;
        private System.Windows.Forms.Timer shimmerTimer;

        public ModernButton()
        {
            this.UseMnemonic = false;
            this.FlatStyle = FlatStyle.Flat;
            this.FlatAppearance.BorderSize = 0;
            this.Cursor = Cursors.Hand;
            this.Font = new Font("Segoe UI", 12f, FontStyle.Bold);
            this.ForeColor = Color.White;
            this.BorderRadius = 12;
            this.NormalColor1 = Theme.AccentPrimary;
            this.NormalColor2 = Theme.AccentPurple;
            this.HoverColor1 = Color.FromArgb(100, 113, 255);
            this.HoverColor2 = Color.FromArgb(140, 74, 255);
            this.PressedColor1 = Theme.AccentPressed;
            this.PressedColor2 = Color.FromArgb(90, 40, 180);
            this.UseGradient = true;
            this.ShowShimmer = false;
            this.DoubleBuffered = true;
            this.SetStyle(ControlStyles.UserPaint | ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer, true);
        }

        public void StartShimmer()
        {
            if (shimmerTimer == null)
            {
                shimmerTimer = new System.Windows.Forms.Timer();
                shimmerTimer.Interval = 25;
                shimmerTimer.Tick += (s, ev) =>
                {
                    if (!this.IsDisposed && this.Visible && this.ShowShimmer)
                    {
                        Form parentForm = this.FindForm();
                        if (parentForm != null && (parentForm.WindowState == FormWindowState.Minimized || !parentForm.Visible)) return;
                        shimmerPos += 0.025f;
                        if (shimmerPos > 2.5f) shimmerPos = -0.5f;
                        this.Invalidate();
                    }
                };
                shimmerTimer.Start();
            }
        }

        protected override void OnMouseEnter(EventArgs e) { base.OnMouseEnter(e); isHovered = true; this.Invalidate(); }
        protected override void OnMouseLeave(EventArgs e) { base.OnMouseLeave(e); isHovered = false; isPressed = false; this.Invalidate(); }
        protected override void OnMouseDown(MouseEventArgs e) { base.OnMouseDown(e); isPressed = true; this.Invalidate(); }
        protected override void OnMouseUp(MouseEventArgs e) { base.OnMouseUp(e); isPressed = false; this.Invalidate(); }

        protected override void OnPaint(PaintEventArgs e)
        {
            e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
            Color parentBg = Theme.GetSafeParentBackground(this, Theme.BgCard);
            using (SolidBrush pb = new SolidBrush(parentBg))
            {
                e.Graphics.FillRectangle(pb, ClientRectangle);
            }

            Rectangle rect = new Rectangle(0, 0, Width - 1, Height - 1);
            Color c1, c2;
            if (isPressed) { c1 = PressedColor1; c2 = PressedColor2; }
            else if (isHovered) { c1 = HoverColor1; c2 = HoverColor2; }
            else { c1 = NormalColor1; c2 = NormalColor2; }

            using (GraphicsPath path = Program.GetRoundedPath(rect, BorderRadius))
            {
                if (UseGradient)
                {
                    using (LinearGradientBrush brush = new LinearGradientBrush(rect, c1, c2, 135f))
                    {
                        e.Graphics.FillPath(brush, path);
                    }
                }
                else
                {
                    using (SolidBrush brush = new SolidBrush(c1))
                    {
                        e.Graphics.FillPath(brush, path);
                    }
                }

                // Shimmer sweep
                if (ShowShimmer && shimmerPos >= -0.5f)
                {
                    e.Graphics.SetClip(path);
                    int shimmerWidth = Math.Max(30, Width / 3);
                    int x = (int)(shimmerPos * (Width + shimmerWidth)) - shimmerWidth;
                    Rectangle sRect = new Rectangle(x, 0, shimmerWidth, Height);
                    if (sRect.Right > 0 && sRect.Left < Width)
                    {
                        using (LinearGradientBrush shimmerBrush = new LinearGradientBrush(
                            sRect,
                            Color.FromArgb(0, 255, 255, 255),
                            Color.FromArgb(50, 255, 255, 255),
                            LinearGradientMode.Horizontal))
                        {
                            e.Graphics.FillRectangle(shimmerBrush, sRect);
                        }
                    }
                    e.Graphics.ResetClip();
                }

                // Hover glow border
                if (isHovered && !isPressed)
                {
                    using (Pen glowPen = new Pen(Color.FromArgb(70, 255, 255, 255), 1.5f))
                    {
                        e.Graphics.DrawPath(glowPen, path);
                    }
                }
            }

            TextRenderer.DrawText(e.Graphics, this.Text, this.Font, this.ClientRectangle, this.ForeColor,
                TextFormatFlags.HorizontalCenter | TextFormatFlags.VerticalCenter | TextFormatFlags.WordBreak | TextFormatFlags.NoPrefix);
        }

        protected override void Dispose(bool disposing)
        {
            if (disposing && shimmerTimer != null)
            {
                shimmerTimer.Stop();
                shimmerTimer.Dispose();
                shimmerTimer = null;
            }
            base.Dispose(disposing);
        }
    }

    public class ModernFlatButton : Button
    {
        public int BorderRadius { get; set; }
        public Color NormalBg { get; set; }
        public Color HoverBg { get; set; }
        public Color NormalBorder { get; set; }
        public Color HoverBorder { get; set; }

        private bool isHovered = false;
        private bool isPressed = false;

        public ModernFlatButton()
        {
            this.UseMnemonic = false;
            this.FlatStyle = FlatStyle.Flat;
            this.FlatAppearance.BorderSize = 0;
            this.Cursor = Cursors.Hand;
            this.Font = new Font("Segoe UI", 9.5f, FontStyle.Bold);
            this.ForeColor = Theme.TextPrimary;
            this.BorderRadius = 12;
            this.NormalBg = Theme.BgElevated;
            this.HoverBg = Color.FromArgb(53, 54, 72);
            this.NormalBorder = Theme.BorderSubtle;
            this.HoverBorder = Theme.BorderMedium;
            this.DoubleBuffered = true;
            this.SetStyle(ControlStyles.UserPaint | ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer, true);
        }

        protected override void OnMouseEnter(EventArgs e) { base.OnMouseEnter(e); isHovered = true; this.Invalidate(); }
        protected override void OnMouseLeave(EventArgs e) { base.OnMouseLeave(e); isHovered = false; isPressed = false; this.Invalidate(); }
        protected override void OnMouseDown(MouseEventArgs e) { base.OnMouseDown(e); isPressed = true; this.Invalidate(); }
        protected override void OnMouseUp(MouseEventArgs e) { base.OnMouseUp(e); isPressed = false; this.Invalidate(); }

        protected override void OnPaint(PaintEventArgs e)
        {
            e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
            Color parentBg = Theme.GetSafeParentBackground(this, Theme.BgCard);
            using (SolidBrush pb = new SolidBrush(parentBg))
            {
                e.Graphics.FillRectangle(pb, ClientRectangle);
            }

            Rectangle rect = new Rectangle(0, 0, Width - 1, Height - 1);
            Color bg = isPressed ? Color.FromArgb(35, 36, 48) : (isHovered ? HoverBg : NormalBg);
            Color border = isHovered ? HoverBorder : NormalBorder;

            using (GraphicsPath path = Program.GetRoundedPath(rect, BorderRadius))
            {
                using (SolidBrush bgBrush = new SolidBrush(bg))
                {
                    e.Graphics.FillPath(bgBrush, path);
                }
                using (Pen borderPen = new Pen(border, 1f))
                {
                    e.Graphics.DrawPath(borderPen, path);
                }
            }

            TextRenderer.DrawText(e.Graphics, this.Text, this.Font, this.ClientRectangle, this.ForeColor,
                TextFormatFlags.HorizontalCenter | TextFormatFlags.VerticalCenter | TextFormatFlags.WordBreak | TextFormatFlags.NoPrefix);
        }
    }

    public class DangerButton : Button
    {
        public int BorderRadius { get; set; }
        private bool isHovered = false;
