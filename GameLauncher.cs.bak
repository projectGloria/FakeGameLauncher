                e.Graphics.FillRectangle(pb, ClientRectangle);
            }

            Rectangle rect = new Rectangle(0, 0, Width - 1, Height - 1);
            Color bg = isPressed ? Color.FromArgb(60, 20, 20) : (isHovered ? Color.FromArgb(55, 25, 25) : Theme.AccentRedBg);
            Color border = isHovered ? Color.FromArgb(120, 40, 40) : Theme.AccentRedBorder;

            using (GraphicsPath path = Program.GetRoundedPath(rect, BorderRadius))
            {
                using (SolidBrush bgBrush = new SolidBrush(bg))
                {
                    e.Graphics.FillPath(bgBrush, path);
                }
                using (Pen borderPen = new Pen(border, 1f))
                {
                    e.Graphics.DrawPath(borderPen, path);
                }
            }

            TextRenderer.DrawText(e.Graphics, this.Text, this.Font, this.ClientRectangle, this.ForeColor,
                TextFormatFlags.HorizontalCenter | TextFormatFlags.VerticalCenter | TextFormatFlags.WordBreak | TextFormatFlags.NoPrefix);
        }
    }

    public class SearchResultsListBox : ListBox
    {
        private int _hoveredIndex = -1;

        public SearchResultsListBox()
        {
            this.DrawMode = DrawMode.OwnerDrawFixed;
            this.ItemHeight = 52;
            this.BackColor = Theme.BgInput;
            this.ForeColor = Theme.TextPrimary;
            this.BorderStyle = BorderStyle.None;
            this.IntegralHeight = false;
            this.Cursor = Cursors.Hand;
            this.Font = new Font("Segoe UI", 10f);
            this.SetStyle(ControlStyles.OptimizedDoubleBuffer | ControlStyles.AllPaintingInWmPaint, true);
        }

        protected override void OnHandleCreated(EventArgs e)
        {
            base.OnHandleCreated(e);
            try
            {
                Program.SetWindowTheme(this.Handle, "DarkMode_Explorer", null);
            }
            catch { }
        }

        protected override void OnMouseMove(MouseEventArgs e)
        {
            base.OnMouseMove(e);
            int index = this.IndexFromPoint(e.Location);
            if (index != _hoveredIndex)
            {
                _hoveredIndex = index;
                this.Invalidate();
            }
        }

        protected override void OnMouseLeave(EventArgs e)
        {
            base.OnMouseLeave(e);
            _hoveredIndex = -1;
            this.Invalidate();
        }

        protected override void OnDrawItem(DrawItemEventArgs e)
        {
            if (e.Index < 0 || e.Index >= this.Items.Count) return;

            GameItem item = this.Items[e.Index] as GameItem;
            if (item == null) return;

            bool isSelected = (e.State & DrawItemState.Selected) == DrawItemState.Selected;
            bool isHovered = (e.Index == _hoveredIndex);

            Graphics g = e.Graphics;
            g.SmoothingMode = SmoothingMode.AntiAlias;

            Color bg = Theme.BgInput;
            if (isSelected) bg = Theme.BgElevated;
            else if (isHovered) bg = Color.FromArgb(28, 29, 40);

            using (SolidBrush b = new SolidBrush(bg))
            {
                g.FillRectangle(b, e.Bounds);
            }

            // Selection accent bar on left
            if (isSelected)
            {
                using (SolidBrush barBrush = new SolidBrush(item.id == "__ADD_CUSTOM__" ? Theme.AccentCyan : Theme.AccentPrimary))
                {
                    g.FillRectangle(barBrush, e.Bounds.X, e.Bounds.Y + 6, 3, e.Bounds.Height - 12);
                }
            }

            if (item.id == "__ADD_CUSTOM__")
            {
                Rectangle plusRect = new Rectangle(e.Bounds.X + 12, e.Bounds.Y + 9, 34, 34);
                using (GraphicsPath pp = Program.GetRoundedPath(plusRect, 8))
                {
                    using (SolidBrush pb = new SolidBrush(Color.FromArgb(40, Theme.AccentCyan)))
                    {
                        g.FillPath(pb, pp);
                    }
                    using (Pen ppen = new Pen(Theme.AccentCyan, 1.5f))
                    {
                        g.DrawPath(ppen, pp);
                    }
                }
                using (Font plusFont = new Font("Segoe UI", 14f, FontStyle.Bold))
                {
                    TextRenderer.DrawText(g, "+", plusFont, plusRect, Theme.AccentCyan,
                        TextFormatFlags.HorizontalCenter | TextFormatFlags.VerticalCenter);
                }

                Rectangle titleRect = new Rectangle(e.Bounds.X + 56, e.Bounds.Y + 7, e.Bounds.Width - 68, 20);
                using (Font titleFont = new Font("Segoe UI", 10.5f, FontStyle.Bold))
                {
                    TextRenderer.DrawText(g, item.name, titleFont, titleRect, Theme.AccentCyan,
                        TextFormatFlags.Left | TextFormatFlags.VerticalCenter | TextFormatFlags.EndEllipsis | TextFormatFlags.NoPrefix);
                }

                Rectangle exeRect = new Rectangle(e.Bounds.X + 56, e.Bounds.Y + 28, e.Bounds.Width - 68, 16);
                using (Font exeFont = new Font("Consolas", 8.5f, FontStyle.Regular))
                {
                    TextRenderer.DrawText(g, item.exe, exeFont, exeRect, Theme.TextSecondary,
                        TextFormatFlags.Left | TextFormatFlags.VerticalCenter | TextFormatFlags.EndEllipsis | TextFormatFlags.NoPrefix);
                }

                using (Pen divPen = new Pen(Color.FromArgb(25, 255, 255, 255), 1f))
                {
                    g.DrawLine(divPen, e.Bounds.X + 12, e.Bounds.Bottom - 1, e.Bounds.Right - 12, e.Bounds.Bottom - 1);
                }
                return;
            }

            // 34x34 rounded thumbnail
            Rectangle iconRect = new Rectangle(e.Bounds.X + 12, e.Bounds.Y + 9, 34, 34);
            Image icon = IconCache.Instance.GetIcon(item, 34, (loadedImg) =>
            {
                if (this.IsHandleCreated)
                {
                    try { this.BeginInvoke(new Action(() => this.Invalidate())); } catch { }
                }
            });

            if (icon != null)
            {
                g.DrawImage(icon, iconRect);
            }

            // Game Title
            Rectangle titleRectNormal = new Rectangle(e.Bounds.X + 56, e.Bounds.Y + 7, e.Bounds.Width - 68, 20);
            using (Font titleFont = new Font("Segoe UI", 10.5f, FontStyle.Bold))
            {
                TextRenderer.DrawText(g, item.name, titleFont, titleRectNormal, Theme.TextPrimary,
                    TextFormatFlags.Left | TextFormatFlags.VerticalCenter | TextFormatFlags.EndEllipsis | TextFormatFlags.NoPrefix);
            }

            // Target .exe name
            Rectangle exeRectNormal = new Rectangle(e.Bounds.X + 56, e.Bounds.Y + 28, e.Bounds.Width - 68, 16);
            using (Font exeFont = new Font("Consolas", 8.5f, FontStyle.Regular))
            {
                TextRenderer.DrawText(g, item.exe, exeFont, exeRectNormal, Theme.TextMuted,
                    TextFormatFlags.Left | TextFormatFlags.VerticalCenter | TextFormatFlags.EndEllipsis | TextFormatFlags.NoPrefix);
            }

            // Bottom divider line
            using (Pen divPen = new Pen(Color.FromArgb(25, 255, 255, 255), 1f))
            {
                g.DrawLine(divPen, e.Bounds.X + 12, e.Bounds.Bottom - 1, e.Bounds.Right - 12, e.Bounds.Bottom - 1);
            }
        }
    }

    public class RoundedIconView : Control
    {
        private Image _image;
        public Image Image
        {
            get { return _image; }
            set { _image = value; this.Invalidate(); }
        }

        public int CornerRadius { get; set; }

        public RoundedIconView(int radius = 12)
        {
            this.CornerRadius = radius;
            this.DoubleBuffered = true;
            this.SetStyle(ControlStyles.UserPaint | ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer, true);
        }

        protected override void OnPaint(PaintEventArgs e)
        {
            Graphics g = e.Graphics;
            g.SmoothingMode = SmoothingMode.AntiAlias;
            g.InterpolationMode = InterpolationMode.HighQualityBicubic;
            g.PixelOffsetMode = PixelOffsetMode.HighQuality;

            // Fill canvas with parent background color to ensure NO white corners
            Color parentBg = Theme.GetSafeParentBackground(this, Theme.BgElevated);
            using (SolidBrush pb = new SolidBrush(parentBg))
            {
                g.FillRectangle(pb, ClientRectangle);
            }

            Rectangle rect = new Rectangle(0, 0, Width - 1, Height - 1);
            using (GraphicsPath path = Program.GetRoundedPath(rect, CornerRadius))
            {
                using (SolidBrush darkBg = new SolidBrush(Color.FromArgb(20, 21, 29)))
                {
                    g.FillPath(darkBg, path);
                }

                if (_image != null)
                {
                    g.SetClip(path);
                    g.DrawImage(_image, 0, 0, Width, Height);
                    g.ResetClip();
                }

                using (Pen p = new Pen(Theme.BorderSubtle, 1f))
                {
                    g.DrawPath(p, path);
                }
            }
        }
    }

    public class PlayedGamesShelfControl : Control
    {
        private List<QualifiedGameEntry> _entries = new List<QualifiedGameEntry>();
        private int _hoveredIndex = -1;
        private ToolTip _toolTip;

        public event Action<GameItem> GameSelected;

        public PlayedGamesShelfControl()
        {
            this.Size = new Size(456, 54);
            this.DoubleBuffered = true;
            this.SetStyle(ControlStyles.UserPaint | ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer, true);
            this.Cursor = Cursors.Default;
            _toolTip = new ToolTip();
            _toolTip.AutoPopDelay = 5000;
            _toolTip.InitialDelay = 150;
            _toolTip.ReshowDelay = 100;
        }

        public void SetGames(List<QualifiedGameEntry> games)
        {
            _entries = games ?? new List<QualifiedGameEntry>();
            _hoveredIndex = -1;
            this.Invalidate();
        }

        protected override void OnMouseMove(MouseEventArgs e)
        {
            base.OnMouseMove(e);
            if (_entries.Count == 0) return;

            int newHover = -1;
            int x = 2;
            for (int i = 0; i < _entries.Count; i++)
            {
                Rectangle tileRect = new Rectangle(x, 2, 48, 50);
                if (tileRect.Contains(e.Location))
                {
                    newHover = i;
                    break;
                }
                x += 56;
                if (x > Width - 48) break;
            }

            if (newHover != _hoveredIndex)
            {
                _hoveredIndex = newHover;
                this.Cursor = (_hoveredIndex >= 0) ? Cursors.Hand : Cursors.Default;
                if (_hoveredIndex >= 0 && _hoveredIndex < _entries.Count)
                {
                    QualifiedGameEntry entry = _entries[_hoveredIndex];
                    int mins = Math.Max(2, entry.total_seconds_played / 60);
                    _toolTip.SetToolTip(this, string.Format("{0}\nPlayed: {1} mins • Click to select", entry.name, mins));
                }
                else
                {
                    _toolTip.SetToolTip(this, null);
                }
                this.Invalidate();
            }
        }

        protected override void OnMouseLeave(EventArgs e)
        {
            base.OnMouseLeave(e);
            if (_hoveredIndex != -1)
            {
                _hoveredIndex = -1;
                this.Cursor = Cursors.Default;
                _toolTip.SetToolTip(this, null);
                this.Invalidate();
            }
        }

        protected override void OnMouseClick(MouseEventArgs e)
        {
            base.OnMouseClick(e);
            if (e.Button == MouseButtons.Left && _hoveredIndex >= 0 && _hoveredIndex < _entries.Count)
            {
                QualifiedGameEntry entry = _entries[_hoveredIndex];
                GameItem item = new GameItem
                {
                    id = entry.id,
                    name = entry.name,
                    icon = entry.icon,
                    exe = entry.exe
                };
                if (GameSelected != null)
                {
                    GameSelected(item);
                }
            }
        }

        protected override void OnPaint(PaintEventArgs e)
        {
            Graphics g = e.Graphics;
            g.SmoothingMode = SmoothingMode.AntiAlias;
            g.InterpolationMode = InterpolationMode.HighQualityBicubic;
            g.PixelOffsetMode = PixelOffsetMode.HighQuality;

            Color parentBg = Theme.GetSafeParentBackground(this, Theme.BgCard);
            using (SolidBrush pb = new SolidBrush(parentBg))
            {
                g.FillRectangle(pb, ClientRectangle);
            }

            if (_entries.Count == 0)
            {
                using (Font font = new Font("Segoe UI", 8.5f, FontStyle.Italic))
                using (SolidBrush textBrush = new SolidBrush(Theme.TextDim))
                {
                    g.DrawString("🎮 Games simulated for 2+ mins will appear here for 1-click launch.", font, textBrush, new PointF(4, 18));
                }
                return;
            }

            int x = 2;
            for (int i = 0; i < _entries.Count; i++)
            {
                QualifiedGameEntry entry = _entries[i];
                bool isHovered = (i == _hoveredIndex);
                int yOffset = isHovered ? 2 : 4;
                Rectangle tileRect = new Rectangle(x, yOffset, 48, 48);

                using (GraphicsPath tilePath = Program.GetRoundedPath(tileRect, 12))
                {
                    Color tileBg1 = isHovered ? Color.FromArgb(50, 52, 70) : Theme.BgElevated;
                    Color tileBg2 = isHovered ? Color.FromArgb(35, 36, 52) : Theme.BgCard;
                    using (LinearGradientBrush b = new LinearGradientBrush(tileRect, tileBg1, tileBg2, 135f))
                    {
                        g.FillPath(b, tilePath);
                    }

                    GameItem game = new GameItem { id = entry.id, name = entry.name, icon = entry.icon, exe = entry.exe };
                    Image icon = IconCache.Instance.GetIcon(game, 34, (loaded) =>
                    {
                        if (this.IsHandleCreated)
                        {
                            try { this.BeginInvoke(new Action(() => this.Invalidate())); } catch { }
                        }
                    });

                    if (icon != null)
                    {
                        Rectangle iconRect = new Rectangle(x + 7, yOffset + 7, 34, 34);
                        using (GraphicsPath iconClip = Program.GetRoundedPath(iconRect, 6))
                        {
                            g.SetClip(iconClip);
                            g.DrawImage(icon, iconRect);
                            g.ResetClip();
                        }
                    }

                    Color borderColor = isHovered ? Theme.AccentPrimary : Theme.BorderMedium;
                    using (Pen p = new Pen(borderColor, isHovered ? 1.8f : 1.2f))
                    {
                        g.DrawPath(p, tilePath);
                    }
                }

                x += 56;
                if (x > Width - 48) break;
            }
        }
    }

    public class StatusGlowDot : Control
    {
        private System.Windows.Forms.Timer _pulseTimer;
        private float _phase = 0f;

        public StatusGlowDot()
        {
            this.Size = new Size(16, 16);
            this.DoubleBuffered = true;
            this.SetStyle(ControlStyles.UserPaint | ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer, true);

            _pulseTimer = new System.Windows.Forms.Timer();
            _pulseTimer.Interval = 40;
            _pulseTimer.Tick += (s, e) =>
            {
                if (!this.IsDisposed && this.Visible)
                {
                    Form parentForm = this.FindForm();
                    if (parentForm != null && (parentForm.WindowState == FormWindowState.Minimized || !parentForm.Visible)) return;
                    _phase += 0.08f;
                    if (_phase > 6.283f) _phase = 0f;
                    this.Invalidate();
                }
            };
            _pulseTimer.Start();
        }

        protected override void OnPaint(PaintEventArgs e)
        {
            e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
            Color parentBg = Theme.GetSafeParentBackground(this, Theme.BgCard);
            using (SolidBrush pb = new SolidBrush(parentBg))
            {
                e.Graphics.FillRectangle(pb, ClientRectangle);
            }

            int alpha = (int)(60 + 50 * Math.Sin(_phase));
            if (alpha < 20) alpha = 20;
            if (alpha > 130) alpha = 130;

            using (SolidBrush glow = new SolidBrush(Color.FromArgb(alpha, Theme.AccentGreen)))
            {
                e.Graphics.FillEllipse(glow, 1, 1, 14, 14);
            }
            using (SolidBrush core = new SolidBrush(Theme.AccentGreen))
            {
                e.Graphics.FillEllipse(core, 4, 4, 8, 8);
            }
        }

        protected override void Dispose(bool disposing)
        {
            if (disposing && _pulseTimer != null)
            {
                _pulseTimer.Stop();
                _pulseTimer.Dispose();
                _pulseTimer = null;
            }
            base.Dispose(disposing);
        }
    }

