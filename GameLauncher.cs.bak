            lblSessionStartTime.Size = new Size(428, 20);
            cardDetails.Controls.Add(lblSessionStartTime);

            ModernCard cardTip = new ModernCard();
            cardTip.Location = new Point(14, 80);
            cardTip.Size = new Size(428, 50);
            cardTip.BackColor = Theme.BgCard;
            cardTip.BorderColor = Theme.BorderSubtle;
            cardTip.Radius = 8;

            lblStreamHint = new Label();
            lblStreamHint.UseMnemonic = false;
            lblStreamHint.Text = "💡 Tip: Stream this window in Discord to complete stream quests.";
            lblStreamHint.Font = new Font("Segoe UI", 8f, FontStyle.Regular);
            lblStreamHint.ForeColor = Theme.TextDim;
            lblStreamHint.Location = new Point(8, 6);
            lblStreamHint.Size = new Size(412, 38);
            cardTip.Controls.Add(lblStreamHint);

            cardDetails.Controls.Add(cardTip);
            card.Controls.Add(cardDetails);

            // Action Buttons Row: Minimize to Tray, Stop Simulation, Exit
            Panel pnlActions = new Panel();
            pnlActions.Location = new Point(16, 256);
            pnlActions.Size = new Size(456, 46);
            pnlActions.BackColor = Theme.BgCard;

            ModernFlatButton btnTray = new ModernFlatButton();
            btnTray.Text = "Minimize to Tray";
            btnTray.Location = new Point(0, 0);
            btnTray.Size = new Size(140, 46);
            btnTray.Font = new Font("Segoe UI", 9.5f, FontStyle.Bold);
            btnTray.Click += (s, e) => MinimizeToTray();
            pnlActions.Controls.Add(btnTray);

            ModernButton btnStop = new ModernButton();
            btnStop.Text = "Stop Simulation";
            btnStop.Location = new Point(148, 0);
            btnStop.Size = new Size(168, 46);
            btnStop.Font = new Font("Segoe UI", 9.5f, FontStyle.Bold);
            btnStop.NormalColor1 = Theme.AccentPrimary;
            btnStop.NormalColor2 = Theme.AccentPurple;
            btnStop.ShowShimmer = true;
            btnStop.StartShimmer();
            btnStop.Click += OnStopAndSwitchClicked;
            pnlActions.Controls.Add(btnStop);

            DangerButton btnExit = new DangerButton();
            btnExit.Text = "Exit App";
            btnExit.Location = new Point(324, 0);
            btnExit.Size = new Size(132, 46);
            btnExit.Font = new Font("Segoe UI", 9.5f, FontStyle.Bold);
            btnExit.Click += (s, e) => ExitApplication();
            pnlActions.Controls.Add(btnExit);

            card.Controls.Add(pnlActions);

            Label lblActiveFooter = new Label();
            lblActiveFooter.UseMnemonic = false;
            lblActiveFooter.Text = "Simulation runs in background. Close (X) sends to tray; Exit App quits.";
            lblActiveFooter.Font = new Font("Segoe UI", 7.5f, FontStyle.Regular);
            lblActiveFooter.ForeColor = Theme.TextDim;
            lblActiveFooter.Location = new Point(16, 320);
            lblActiveFooter.Size = new Size(456, 20);
            lblActiveFooter.TextAlign = ContentAlignment.MiddleCenter;
            card.Controls.Add(lblActiveFooter);

            pnlActive.Controls.Add(card);
            this.Controls.Add(pnlActive);
        }

        private void SwitchToActiveMode()
        {
            isSimulatingMode = true;
            this.Text = currentDisplayName;
            Program.SetWindowText(this.Handle, currentDisplayName);
            pnlLauncher.Visible = false;
            pnlActive.Visible = true;

            lblActiveGameTitle.Text = currentDisplayName;
            lblActiveProcessInfo.Text = string.Format("{0}  |  PID: {1}{2}", currentExeName, Process.GetCurrentProcess().Id, (activeSimulatingGame != null && !string.IsNullOrEmpty(activeSimulatingGame.id)) ? ("  |  App ID: " + activeSimulatingGame.id) : "");
            lblSessionStartTime.Text = "Session started at: " + DateTime.Now.ToString("HH:mm:ss");

            if (activeSimulatingGame != null)
            {
                picActiveGameIcon.Image = IconCache.Instance.GetIcon(activeSimulatingGame, 58, (loaded) =>
                {
                    if (this.IsHandleCreated)
                    {
                        try { this.BeginInvoke(new Action(() => picActiveGameIcon.Image = loaded)); } catch { }
                    }
                });
            }
            else
            {
                picActiveGameIcon.Image = IconCache.Instance.GetFallbackGamepadIcon(58);
            }

            sessionStopwatch = Stopwatch.StartNew();
            hasSaved2MinQualification = false;
            qualificationFinalRecorded = false;
            qualificationTrackerTimer.Start();

            if (activeSimulatingGame != null)
            {
                GameDatabase.Instance.SaveLastSimulatedGame(activeSimulatingGame);
            }
            else if (!string.IsNullOrEmpty(currentDisplayName))
            {
                GameDatabase.Instance.SaveLastSimulatedGame(new GameItem
                {
                    name = currentDisplayName,
                    exe = currentExeName
                });
            }

            UpdateTrayContextMenu();

            if (trayIcon != null)
            {
                string t = "Playing: " + currentDisplayName;
                trayIcon.Text = t.Length > 63 ? t.Substring(0, 63) : t;
            }

            bool isFc27 = string.Equals(currentExeName, "fc27.exe", StringComparison.OrdinalIgnoreCase) ||
                          (!string.IsNullOrEmpty(currentDisplayName) && currentDisplayName.IndexOf("FC 27", StringComparison.OrdinalIgnoreCase) >= 0);
            if (isFc27 && lblStreamHint != null)
            {
                lblStreamHint.Text = "⚠️ Quest Tip: Keep Discord status 'Online' (not Idle). If progress pauses, press Ctrl+R in Discord to reload game detection.";
                lblStreamHint.ForeColor = Theme.AccentYellow;
            }
            else if (lblStreamHint != null)
            {
                lblStreamHint.Text = "💡 Tip: Stream this window in Discord to complete stream quests.";
                lblStreamHint.ForeColor = Theme.TextDim;
            }

            if (activeSimulatingGame == null || string.IsNullOrWhiteSpace(activeSimulatingGame.id))
            {
                if (lblActiveHeaderRight != null)
                {
                    lblActiveHeaderRight.Text = "● Process Spoofed (No App ID)";
                    lblActiveHeaderRight.ForeColor = Theme.TextMuted;
                }
                if (lblHookStatus != null)
                {
                    lblHookStatus.Text = "● Process Detection Active (Discord Process Matching)";
                    lblHookStatus.ForeColor = Theme.AccentCyan;
                }
            }
            else
            {
                if (lblActiveHeaderRight != null)
                {
                    lblActiveHeaderRight.Text = "● Connecting to Discord...";
                    lblActiveHeaderRight.ForeColor = Theme.AccentCyan;
                }
                if (lblHookStatus != null)
                {
                    lblHookStatus.Text = "● Connecting to Discord IPC...";
                    lblHookStatus.ForeColor = Theme.AccentCyan;
                }
            }

            StartDiscordRpc(activeSimulatingGame);
        }

        private void SwitchToLauncherMode()
        {
            StopDiscordRpc();
            isSimulatingMode = false;
            this.Text = "Discord Quest Launcher";
            Program.SetWindowText(this.Handle, "Discord Quest Launcher");
            pnlActive.Visible = false;
            pnlLauncher.Visible = true;
            if (qualificationTrackerTimer != null) qualificationTrackerTimer.Stop();

            EnsureDatabaseInitialized();

            UpdateTrayContextMenu();

            if (trayIcon != null)
            {
                trayIcon.Text = "Discord Quest Launcher";
            }
            PopulatePlayedGamesShelf();
        }

        private void StartDiscordRpc(GameItem game)
        {
            StopDiscordRpc();
            if (game == null || string.IsNullOrWhiteSpace(game.id)) return;
            string appId = game.id.Trim();
            string appName = game.name ?? "Game";
            string iconHash = game.icon ?? "";

            lock (_rpcLock)
            {
                int sessionId = ++_rpcSessionId;
                rpcRunning = true;
                rpcThread = new Thread(() =>
                {
                    long startEpoch = (long)(DateTime.UtcNow - new DateTime(1970, 1, 1, 0, 0, 0, DateTimeKind.Utc)).TotalSeconds;
                    while (rpcRunning && _rpcSessionId == sessionId)
                    {
                        bool isConnected = false;
                        try
                        {
                            if (rpcClient == null || !rpcClient.IsConnected)
                            {
                                if (rpcClient != null) { try { rpcClient.Dispose(); } catch { } rpcClient = null; }
                                rpcClient = new DiscordRpcClient(appId);
                                if (rpcClient.Connect(1000))
                                {
                                    rpcClient.SetActivity(appName, "In Game", iconHash, appName, startEpoch);
                                    isConnected = true;
                                }
                            }
                            else
                            {
                                rpcClient.SetActivity(appName, "In Game", iconHash, appName, startEpoch);
                                isConnected = true;
                            }
                        }
                        catch { }

                        // Update UI status safely
                        if (this.IsHandleCreated && !this.IsDisposed && _rpcSessionId == sessionId)
                        {
                            try
                            {
                                this.BeginInvoke(new Action(() =>
                                {
                                    if (!isSimulatingMode) return;
                                    if (isConnected)
                                    {
                                        if (lblActiveHeaderRight != null)
                                        {
                                            lblActiveHeaderRight.Text = "● Presence Broadcasting";
                                            lblActiveHeaderRight.ForeColor = Theme.AccentGreen;
                                        }
                                        if (lblHookStatus != null)
                                        {
                                            lblHookStatus.Text = "● Discord RPC & Game Detection Active";
                                            lblHookStatus.ForeColor = Theme.AccentGreen;
                                        }
                                    }
                                    else
                                    {
                                        if (lblActiveHeaderRight != null)
                                        {
                                            lblActiveHeaderRight.Text = "● Discord Not Connected";
                                            lblActiveHeaderRight.ForeColor = Theme.AccentYellow;
                                        }
                                        if (lblHookStatus != null)
                                        {
                                            lblHookStatus.Text = "● Process Spoofed (Discord Not Detected / Retrying RPC)";
                                            lblHookStatus.ForeColor = Theme.AccentYellow;
                                        }
                                    }
                                }));
                            }
                            catch { }
                        }

                        int sleepSeconds = isConnected ? 20 : 3;
                        for (int i = 0; i < sleepSeconds && rpcRunning && _rpcSessionId == sessionId; i++)
                        {
                            Thread.Sleep(1000);
                        }
                    }

                    try
                    {
                        if (rpcClient != null)
                        {
                            rpcClient.Dispose();
                            rpcClient = null;
                        }
                    }
                    catch { }
                });
                rpcThread.IsBackground = true;
                rpcThread.Name = "DiscordRpcWorker";
                rpcThread.Start();
            }
        }

        private void StopDiscordRpc()
        {
            lock (_rpcLock)
            {
                rpcRunning = false;
                _rpcSessionId++;
                try
                {
                    if (rpcThread != null && rpcThread.IsAlive)
                    {
                        rpcThread.Join(500);
                    }
                }
                catch { }
                rpcThread = null;
                try
                {
                    if (rpcClient != null)
                    {
                        rpcClient.Dispose();
                        rpcClient = null;
                    }
                }
                catch { }
            }
        }

        private void OnQualificationTrackerTick(object sender, EventArgs e)
        {
            // Just marks that 2 minutes was reached; actual recording happens at stop/close
            if (sessionStopwatch != null && isSimulatingMode && !hasSaved2MinQualification)
            {
                if (sessionStopwatch.Elapsed.TotalSeconds >= 120)
                {
                    hasSaved2MinQualification = true;
                    qualificationTrackerTimer.Stop();
                }
            }
        }

        private void LaunchSimulation(string rawInput)
        {
            string input = rawInput.Trim().Trim('"', '\'');
            if (string.IsNullOrWhiteSpace(input))
            {
                MessageBox.Show("Please enter a game name or executable.", "Missing Game Name", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            string exeName = input;
            string displayName = "";
            string iconId = "";
            string iconHash = "";

            if (selectedGame != null && selectedGame.id != "__ADD_CUSTOM__" &&
                (string.Equals(selectedGame.name, input, StringComparison.OrdinalIgnoreCase) ||
                 string.Equals(selectedGame.exe, input, StringComparison.OrdinalIgnoreCase)))
            {
                exeName = selectedGame.exe;
                displayName = selectedGame.name;
                iconId = selectedGame.id ?? "";
                iconHash = selectedGame.icon ?? "";
            }
            else
            {
                GameItem match = GameDatabase.Instance.FindExactGame(input);
                if (match == null)
                {
                    List<GameItem> searchMatches = GameDatabase.Instance.Search(input, 1);
                    if (searchMatches.Count > 0 && searchMatches[0].id != "__ADD_CUSTOM__")
                    {
                        match = searchMatches[0];
                    }
                }

                if (match != null)
                {
                    SelectGame(match);
                    exeName = match.exe;
                    displayName = match.name;
                    iconId = match.id ?? "";
                    iconHash = match.icon ?? "";
                }
                else
                {
                    if (!exeName.EndsWith(".exe", StringComparison.OrdinalIgnoreCase))
                    {
                        exeName = GameDatabase.InferExecutableFromName(input);
                    }
                    displayName = FormatDisplayName(input);
                }
            }

            GameDatabase.Instance.SaveLastSimulatedGame(new GameItem
            {
                id = iconId,
                name = displayName,
                icon = iconHash,
                exe = exeName
            });

            string tempDir = Path.Combine(Path.GetTempPath(), "DiscordDummyTools");
            if (!Directory.Exists(tempDir))
            {
                Directory.CreateDirectory(tempDir);
            }

            // Sanitize exe name to prevent path traversal (e.g. "..\..\..\Windows\System32\cmd.exe")
            exeName = Path.GetFileName(exeName);
            if (string.IsNullOrEmpty(exeName) || exeName.IndexOfAny(Path.GetInvalidFileNameChars()) >= 0)
            {
                MessageBox.Show("Invalid executable name.", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            // Ensure valid .exe extension (some discord applications point to .bin, .des, or .game files)
            if (!exeName.EndsWith(".exe", StringComparison.OrdinalIgnoreCase))
            {
                exeName = Path.GetFileNameWithoutExtension(exeName) + ".exe";
            }

            string targetExePath = Path.Combine(tempDir, exeName);

            // Special support for EA Sports FC 27 and Steam SKU quests
            bool isFc27 = string.Equals(exeName, "fc27.exe", StringComparison.OrdinalIgnoreCase) ||
                          (!string.IsNullOrEmpty(displayName) && displayName.IndexOf("FC 27", StringComparison.OrdinalIgnoreCase) >= 0);
            if (isFc27)
            {
                string steamPath = GetSteamPath();
                if (!string.IsNullOrEmpty(steamPath))
                {
                    string steamapps = Path.Combine(steamPath, "steamapps");
                    if (Directory.Exists(steamapps))
                    {
                        string steamGameDir = Path.Combine(steamapps, "common", "EA SPORTS FC 27");
                        string steamExePath = Path.Combine(steamGameDir, "fc27.exe");

                        // Safety: if the real game is installed, do NOT touch Steam files at all.
                        // Our launcher is ~87KB; a real game exe is much larger.
                        bool realGameInstalled = File.Exists(steamExePath);
                        if (realGameInstalled)
                        {
                            try
                            {
                                long fileSize = new FileInfo(steamExePath).Length;
                                realGameInstalled = (fileSize > 500000);
                            }
                            catch { realGameInstalled = true; }
                        }

                        if (!realGameInstalled)
                        {
                            // Safety: skip VDF edits if Steam is currently running to avoid corruption
                            bool steamRunning = false;
                            try { steamRunning = Process.GetProcessesByName("steam").Length > 0; } catch { }

                            string acfPath = Path.Combine(steamapps, "appmanifest_4080220.acf");
                            if (!File.Exists(acfPath))
                            {
                                try
                                {
                                    string acfContent = "\"AppState\"\n{\n\t\"appid\"\t\t\"4080220\"\n\t\"Universe\"\t\t\"1\"\n\t\"name\"\t\t\"EA SPORTS FC 27\"\n\t\"StateFlags\"\t\t\"4\"\n\t\"installdir\"\t\t\"EA SPORTS FC 27\"\n}\n";
                                    File.WriteAllText(acfPath, acfContent, Encoding.UTF8);
                                }
                                catch { }
                            }

                            if (!steamRunning)
                            {
                                string libPath = Path.Combine(steamapps, "libraryfolders.vdf");
                                if (File.Exists(libPath))
                                {
                                    try
                                    {
                                        string libText = File.ReadAllText(libPath);
                                        if (!libText.Contains("\"4080220\""))
                                        {
                                            // Back up before modifying
                                            string backupPath = libPath + ".bak";
                                            if (!File.Exists(backupPath))
                                            {
                                                File.Copy(libPath, backupPath);
                                            }
                                            int appsIdx = libText.IndexOf("\"apps\"");
                                            if (appsIdx >= 0)
                                            {
                                                int closeBrace = libText.IndexOf('}', appsIdx);
                                                if (closeBrace >= 0)
                                                {
                                                    string newLib = libText.Insert(closeBrace, "\t\t\t\"4080220\"\t\t\"50000000000\"\n\t\t");
                                                    File.WriteAllText(libPath, newLib, Encoding.UTF8);
                                                }
                                            }
                                        }
                                    }
                                    catch { }
                                }
                            }

                            if (!Directory.Exists(steamGameDir))
                            {
                                try { Directory.CreateDirectory(steamGameDir); } catch { }
                            }
                            if (Directory.Exists(steamGameDir))
                            {
                                targetExePath = steamExePath;
                            }
                        }
                        // If real game is installed, fall through and use tempDir path
                    }
                }
            }

            string currentExePath = Application.ExecutablePath;

            if (string.Equals(currentExePath, targetExePath, StringComparison.OrdinalIgnoreCase))
            {
                currentDisplayName = displayName;
                currentExeName = exeName;
                SwitchToActiveMode();
                return;
            }

            try
            {
                string processBaseName = Path.GetFileNameWithoutExtension(targetExePath);
                Process[] existing = Process.GetProcessesByName(processBaseName);
                foreach (var p in existing)
                {
                    try
                    {
                        // Only kill processes that are our own dummy, not real game processes
                        string pPath = p.MainModule.FileName;
                        if (string.Equals(pPath, targetExePath, StringComparison.OrdinalIgnoreCase))
                        {
                            p.Kill();
                            p.WaitForExit(1000);
                        }
                    }
                    catch { }
                    finally
                    {
                        try { p.Dispose(); } catch { }
                    }
                }
            }
            catch { }

            try
            {
                File.Copy(currentExePath, targetExePath, true);
            }
            catch (Exception ex)
            {
                MessageBox.Show("Failed to create dummy executable:\n" + ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            int trayFlag = chkMinimizeToTray.Checked ? 1 : 0;

            ProcessStartInfo psi = new ProcessStartInfo();
            psi.FileName = targetExePath;
            psi.Arguments = string.Format("--simulating \"{0}\" \"{1}\" {2} {3} {4} \"{5}\" \"{6}\" \"{7}\"",
                displayName, currentExePath, this.Location.X, this.Location.Y, trayFlag, exeName, iconId, iconHash);
            psi.UseShellExecute = true;

            try
            {
                Process.Start(psi);
                isSwitchingProcesses = true;
                if (trayIcon != null)
                {
                    trayIcon.Visible = false;
                    trayIcon.Dispose();
                    trayIcon = null;
                }
                this.Close();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Failed to start dummy executable:\n" + ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void OnStopAndSwitchClicked(object sender, EventArgs e)
        {
            StopDiscordRpc();
            // Record qualification once if played >= 2 minutes
            if (!qualificationFinalRecorded && sessionStopwatch != null && sessionStopwatch.Elapsed.TotalSeconds >= 120 && activeSimulatingGame != null)
            {
                qualificationFinalRecorded = true;
                GameDatabase.Instance.RecordQualifiedGame(activeSimulatingGame, (int)sessionStopwatch.Elapsed.TotalSeconds);
            }

            if (!string.IsNullOrEmpty(originalLauncherPath) && File.Exists(originalLauncherPath))
            {
                isSwitchingProcesses = true;
                if (trayIcon != null)
                {
                    trayIcon.Visible = false;
                    trayIcon.Dispose();
                    trayIcon = null;
                }

                ProcessStartInfo psi = new ProcessStartInfo();
                psi.FileName = originalLauncherPath;
                psi.Arguments = string.Format("--launcher {0} {1}", this.Location.X, this.Location.Y);
                psi.UseShellExecute = true;
                try
                {
                    Process.Start(psi);
                }
                catch { }

                ScheduleTempCleanup(Application.ExecutablePath);
                this.Close();
            }
            else
            {
                SwitchToLauncherMode();
            }
        }

        private bool isExplicitExit = false;

        public void ExitApplication()
        {
            StopDiscordRpc();
            isExplicitExit = true;
            this.Close();
        }

        public void MinimizeToTray()
        {
            if (this.InvokeRequired)
            {
                this.BeginInvoke(new Action(MinimizeToTray));
                return;
            }

            this.Hide();

            if (trayIcon != null)
            {
                trayIcon.Visible = true;
                string title = isSimulatingMode ? ("Simulating: " + currentDisplayName) : "Discord Quest Launcher";
                string tip = title.Length > 63 ? title.Substring(0, 63) : title;
                trayIcon.Text = tip;
                try
                {
                    trayIcon.ShowBalloonTip(1500, "Discord Quest Launcher", title + "\nRunning in system tray. Right-click icon to exit.", ToolTipIcon.Info);
                }
                catch { }
            }
        }

        public void RestoreFromTray()
        {
            if (this.InvokeRequired)
            {
                this.BeginInvoke(new Action(RestoreFromTray));
                return;
            }

            this.Show();
            if (this.WindowState == FormWindowState.Minimized)
            {
                this.WindowState = FormWindowState.Normal;
            }
            Program.ShowWindow(this.Handle, 9);
            this.BringToFront();
            this.Activate();
            Program.SetForegroundWindow(this.Handle);
        }

        protected override void OnFormClosing(FormClosingEventArgs e)
        {
            // If "Minimize to Tray" is selected and user pressed Close button (X), send to system tray instead of closing
            if (!isExplicitExit && !isSwitchingProcesses && e.CloseReason != CloseReason.WindowsShutDown && e.CloseReason != CloseReason.ApplicationExitCall)
            {
                if (chkMinimizeToTray == null || chkMinimizeToTray.Checked)
                {
                    e.Cancel = true;
                    MinimizeToTray();
                    return;
                }
            }

            StopDiscordRpc();
            base.OnFormClosing(e);

            // Record qualification if played >= 2 minutes before exit (only if not already recorded at stop)
            if (!qualificationFinalRecorded && sessionStopwatch != null && sessionStopwatch.Elapsed.TotalSeconds >= 120 && activeSimulatingGame != null)
            {
                qualificationFinalRecorded = true;
                GameDatabase.Instance.RecordQualifiedGame(activeSimulatingGame, (int)sessionStopwatch.Elapsed.TotalSeconds);
            }

            if (trayIcon != null)
            {
                trayIcon.Visible = false;
                trayIcon.Dispose();
            }

            if (qualificationTrackerTimer != null)
            {
                qualificationTrackerTimer.Stop();
                qualificationTrackerTimer.Dispose();
            }

            if (debounceTimer != null)
            {
                debounceTimer.Stop();
                debounceTimer.Dispose();
            }

            if (isSimulatingMode && !isSwitchingProcesses)
            {
                ScheduleTempCleanup(Application.ExecutablePath);
            }
        }

        protected override void OnFormClosed(FormClosedEventArgs e)
        {
            base.OnFormClosed(e);
            Application.Exit();
        }

        private static void ScheduleTempCleanup(string exePath)
        {
            try
            {
                string tempDir = Path.GetTempPath();
                if (exePath.StartsWith(tempDir, StringComparison.OrdinalIgnoreCase))
                {
                    ProcessStartInfo psi = new ProcessStartInfo();
                    psi.FileName = "cmd.exe";
                    psi.Arguments = string.Format("/c for /l %i in (1,1,10) do ( ping 127.0.0.1 -n 2 >nul & del /f /q \"{0}\" 2>nul & if not exist \"{0}\" exit )", exePath);
                    psi.WindowStyle = ProcessWindowStyle.Hidden;
                    psi.CreateNoWindow = true;
                    psi.UseShellExecute = false;
                    Process.Start(psi);
                }
            }
            catch { }
        }

        private static string GetSteamPath()
        {
            try
            {
                using (var key = Registry.CurrentUser.OpenSubKey(@"Software\Valve\Steam"))
                {
                    if (key != null)
                    {
                        object val = key.GetValue("SteamPath");
                        if (val != null && !string.IsNullOrWhiteSpace(val.ToString()))
                            return val.ToString().Replace('/', '\\');
                    }
                }
            }
            catch { }
            try
            {
                using (var key = Registry.LocalMachine.OpenSubKey(@"Software\Valve\Steam") ??
                                 Registry.LocalMachine.OpenSubKey(@"Software\WOW6432Node\Valve\Steam"))
                {
                    if (key != null)
                    {
                        object val = key.GetValue("InstallPath");
                        if (val != null && !string.IsNullOrWhiteSpace(val.ToString()))
                            return val.ToString().Replace('/', '\\');
                    }
                }
            }
            catch { }
            string defaultPath = @"C:\Program Files (x86)\Steam";
            if (Directory.Exists(defaultPath)) return defaultPath;
            return null;
        }

        private void ShowAddCustomGameDialog(string initialQuery)
        {
            using (Form dialog = new Form())
            {
                dialog.Text = "Add Custom Game";
                dialog.StartPosition = FormStartPosition.CenterParent;
                dialog.FormBorderStyle = FormBorderStyle.FixedDialog;
                dialog.MaximizeBox = false;
                dialog.MinimizeBox = false;
                dialog.ShowInTaskbar = false;
                dialog.ClientSize = new Size(420, 265);
                dialog.BackColor = Theme.BgBase;
                dialog.ForeColor = Theme.TextPrimary;
                Program.EnableImmersiveDarkMode(dialog.Handle);

                Label lblHeader = new Label();
                lblHeader.Text = "Add Custom Game or Override";
                lblHeader.Font = new Font("Segoe UI", 12f, FontStyle.Bold);
                lblHeader.ForeColor = Theme.TextBright;
                lblHeader.Location = new Point(16, 14);
                lblHeader.Size = new Size(388, 24);
                dialog.Controls.Add(lblHeader);

                Label lblName = new Label();
                lblName.Text = "Game Display Name:";
                lblName.Font = new Font("Segoe UI", 8.5f, FontStyle.Regular);
                lblName.ForeColor = Theme.TextSecondary;
                lblName.Location = new Point(16, 44);
                lblName.Size = new Size(388, 16);
                dialog.Controls.Add(lblName);

                TextBox txtName = new TextBox();
                txtName.Location = new Point(16, 62);
                txtName.Size = new Size(388, 24);
                txtName.Font = new Font("Segoe UI", 9.5f);
                txtName.BackColor = Theme.BgInput;
                txtName.ForeColor = Theme.TextBright;
                txtName.BorderStyle = BorderStyle.FixedSingle;
                txtName.Text = initialQuery != null ? initialQuery.Trim() : "";
                dialog.Controls.Add(txtName);

                Label lblExe = new Label();
                lblExe.Text = "Target Executable (.exe name, e.g. fc27.exe):";
                lblExe.Font = new Font("Segoe UI", 8.5f, FontStyle.Regular);
                lblExe.ForeColor = Theme.TextSecondary;
                lblExe.Location = new Point(16, 94);
                lblExe.Size = new Size(388, 16);
                dialog.Controls.Add(lblExe);

                TextBox txtExe = new TextBox();
                txtExe.Location = new Point(16, 112);
                txtExe.Size = new Size(388, 24);
                txtExe.Font = new Font("Consolas", 9.5f);
                txtExe.BackColor = Theme.BgInput;
                txtExe.ForeColor = Theme.AccentGreen;
                txtExe.BorderStyle = BorderStyle.FixedSingle;
                txtExe.Text = GameDatabase.InferExecutableFromName(txtName.Text);
                dialog.Controls.Add(txtExe);

                bool exeManuallyEdited = false;
                bool suppressExeAutoUpdate = false;
                txtExe.TextChanged += (s, e) =>
                {
                    if (!suppressExeAutoUpdate) exeManuallyEdited = true;
                };
                txtName.TextChanged += (s, e) =>
                {
                    if (!exeManuallyEdited)
                    {
                        suppressExeAutoUpdate = true;
                        txtExe.Text = GameDatabase.InferExecutableFromName(txtName.Text);
                        suppressExeAutoUpdate = false;
                    }
                };

                Label lblId = new Label();
                lblId.Text = "Discord Application ID (Optional):";
                lblId.Font = new Font("Segoe UI", 8.5f, FontStyle.Regular);
                lblId.ForeColor = Theme.TextMuted;
                lblId.Location = new Point(16, 144);
                lblId.Size = new Size(388, 16);
                dialog.Controls.Add(lblId);

                TextBox txtId = new TextBox();
                txtId.Location = new Point(16, 162);
                txtId.Size = new Size(388, 24);
                txtId.Font = new Font("Segoe UI", 9f);
                txtId.BackColor = Theme.BgInput;
                txtId.ForeColor = Theme.TextPrimary;
                txtId.BorderStyle = BorderStyle.FixedSingle;
                dialog.Controls.Add(txtId);

                ModernButton btnSave = new ModernButton();
                btnSave.Text = "Save & Select Game";
                btnSave.Location = new Point(234, 206);
                btnSave.Size = new Size(170, 36);
                btnSave.Font = new Font("Segoe UI", 9.5f, FontStyle.Bold);
                btnSave.NormalColor1 = Theme.AccentPrimary;
                btnSave.NormalColor2 = Theme.AccentPurple;
                btnSave.BorderRadius = 8;
                btnSave.Click += (s, e) =>
                {
                    string gName = txtName.Text.Trim();
                    string gExe = txtExe.Text.Trim();
                    string gId = txtId.Text.Trim();

                    if (string.IsNullOrEmpty(gName))
                    {
                        MessageBox.Show(dialog, "Please enter a game name.", "Input Required", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                        return;
                    }
                    if (string.IsNullOrEmpty(gExe))
                    {
                        gExe = GameDatabase.InferExecutableFromName(gName);
                    }
                    if (!gExe.EndsWith(".exe", StringComparison.OrdinalIgnoreCase))
                    {
                        gExe += ".exe";
                    }

                    GameItem custom = new GameItem
                    {
                        name = gName,
                        exe = gExe,
                        id = gId,
                        icon = ""
                    };

                    GameDatabase.Instance.AddCustomGame(custom);
                    SelectGame(custom);
                    dialog.DialogResult = DialogResult.OK;
                    dialog.Close();
                };
                dialog.Controls.Add(btnSave);

                Button btnCancel = new Button();
                btnCancel.Text = "Cancel";
                btnCancel.Location = new Point(144, 206);
                btnCancel.Size = new Size(80, 36);
                btnCancel.Font = new Font("Segoe UI", 9f);
                btnCancel.ForeColor = Theme.TextSecondary;
                btnCancel.BackColor = Theme.BgCard;
                btnCancel.FlatStyle = FlatStyle.Flat;
                btnCancel.FlatAppearance.BorderColor = Theme.BorderMedium;
                btnCancel.Cursor = Cursors.Hand;
                btnCancel.Click += (s, e) => dialog.Close();
                dialog.Controls.Add(btnCancel);

                dialog.AcceptButton = btnSave;
                dialog.CancelButton = btnCancel;

                dialog.ShowDialog(this);
            }
        }

        public static string FormatDisplayName(string raw)
        {
            if (string.IsNullOrWhiteSpace(raw)) return "Game";
            string name = raw.Trim();
            // Only strip extension if it looks like a real executable filename
            if (name.EndsWith(".exe", StringComparison.OrdinalIgnoreCase) ||
                name.EndsWith(".bin", StringComparison.OrdinalIgnoreCase) ||
                name.EndsWith(".cmd", StringComparison.OrdinalIgnoreCase))
            {
                name = Path.GetFileNameWithoutExtension(name);
            }

            Match mFc = Regex.Match(name, @"^(?:ea\s*sports\s*)?fc\s*(\d+)$", RegexOptions.IgnoreCase);
            if (mFc.Success) return "EA Sports FC " + mFc.Groups[1].Value;
            Match mFifa = Regex.Match(name, @"^fifa\s*(\d+)$", RegexOptions.IgnoreCase);
            if (mFifa.Success) return "FIFA " + mFifa.Groups[1].Value;
            Match mUfc = Regex.Match(name, @"^(?:ea\s*sports\s*)?ufc\s*(\d+)$", RegexOptions.IgnoreCase);
            if (mUfc.Success) return "EA Sports UFC " + mUfc.Groups[1].Value;

            if (name.IndexOf("where winds meet", StringComparison.OrdinalIgnoreCase) >= 0)
                return "Where Winds Meet";
            if (name.IndexOf("wuthering waves", StringComparison.OrdinalIgnoreCase) >= 0 || name.Equals("Client-Win64-Shipping", StringComparison.OrdinalIgnoreCase))
                return "Wuthering Waves";
            if (name.IndexOf("starrail", StringComparison.OrdinalIgnoreCase) >= 0 || name.IndexOf("honkai", StringComparison.OrdinalIgnoreCase) >= 0)
                return "Honkai: Star Rail";
            if (name.IndexOf("genshin", StringComparison.OrdinalIgnoreCase) >= 0)
                return "Genshin Impact";
            if (name.IndexOf("zenless", StringComparison.OrdinalIgnoreCase) >= 0 || Regex.IsMatch(name, @"\bzzz\b", RegexOptions.IgnoreCase))
                return "Zenless Zone Zero";
            if (name.IndexOf("warframe", StringComparison.OrdinalIgnoreCase) >= 0)
                return "Warframe";
            if (name.IndexOf("firstdescendant", StringComparison.OrdinalIgnoreCase) >= 0)
                return "The First Descendant";

            string cleaned = name.Replace('_', ' ').Replace('-', ' ').Trim();
            try
            {
                System.Globalization.TextInfo ti = System.Globalization.CultureInfo.CurrentCulture.TextInfo;
                return ti.ToTitleCase(cleaned.ToLowerInvariant());
            }
            catch
            {
                return cleaned;
            }
        }

        private static Icon CreateAppIcon()
        {
            try
            {
                using (Bitmap bmp = new Bitmap(32, 32, PixelFormat.Format32bppArgb))
                {
                    using (Graphics g = Graphics.FromImage(bmp))
                    {
                        g.SmoothingMode = SmoothingMode.AntiAlias;
                        g.Clear(Color.Transparent);
                        using (SolidBrush b = new SolidBrush(Color.FromArgb(88, 101, 242)))
                        {
                            g.FillEllipse(b, 2, 2, 28, 28);
                        }
                        using (SolidBrush wb = new SolidBrush(Color.White))
                        {
                            g.FillRectangle(wb, 8, 14, 16, 5);
                            g.FillRectangle(wb, 13.5f, 8.5f, 5, 16);
                        }
                    }
                    IntPtr hIcon = bmp.GetHicon();
                    try
                    {
                        using (Icon temp = Icon.FromHandle(hIcon))
                        {
                            return (Icon)temp.Clone();
                        }
                    }
                    finally
                    {
                        Program.DestroyIcon(hIcon);
                    }
                }
            }
            catch
            {
                return SystemIcons.Application;
            }
        }
    }
}
