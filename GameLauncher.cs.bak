    public class SearchBox : Panel
    {
        public TextBox Input { get; private set; }
        public Label ClearButton { get; private set; }
        public string Placeholder { get; set; }
        public int Radius { get; set; }

        public SearchBox()
        {
            this.Radius = 12;
            this.Placeholder = "Search 10,000+ games (e.g. Genshin, Where Winds Meet)...";
            this.BackColor = Theme.BgInput;
            this.Size = new Size(456, 42);
            this.DoubleBuffered = true;
            this.SetStyle(ControlStyles.UserPaint | ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer, true);

            Input = new TextBox();
            Input.BorderStyle = BorderStyle.None;
            Input.BackColor = Theme.BgInput;
            Input.ForeColor = Theme.TextPrimary;
            Input.Font = new Font("Segoe UI", 10.5f, FontStyle.Regular);
            Input.Location = new Point(38, 11);
            Input.Width = this.Width - 72;

            ClearButton = new Label();
            ClearButton.Text = "✕";
            ClearButton.Font = new Font("Segoe UI", 8.5f, FontStyle.Bold);
            ClearButton.ForeColor = Theme.TextMuted;
            ClearButton.BackColor = Theme.BgElevated;
            ClearButton.Size = new Size(22, 22);
            ClearButton.Cursor = Cursors.Hand;
            ClearButton.TextAlign = ContentAlignment.MiddleCenter;
            ClearButton.Visible = false;

            ClearButton.MouseEnter += (s, e) =>
            {
                ClearButton.BackColor = Theme.AccentPrimary;
                ClearButton.ForeColor = Color.White;
            };
            ClearButton.MouseLeave += (s, e) =>
            {
                ClearButton.BackColor = Theme.BgElevated;
                ClearButton.ForeColor = Theme.TextMuted;
            };

            Input.GotFocus += (s, e) => this.Invalidate();
            Input.LostFocus += (s, e) => this.Invalidate();
            Input.TextChanged += (s, e) =>
            {
                ClearButton.Visible = !string.IsNullOrEmpty(Input.Text);
                this.Invalidate();
            };

            this.Controls.Add(Input);
            this.Controls.Add(ClearButton);
            LayoutControls();
        }

        protected override void OnResize(EventArgs eventargs)
        {
            base.OnResize(eventargs);
            LayoutControls();
        }

        private void LayoutControls()
        {
            if (Input != null)
            {
                Input.Location = new Point(38, (this.Height - Input.PreferredHeight) / 2);
                Input.Width = Math.Max(50, this.Width - 72);
            }
            if (ClearButton != null)
            {
                ClearButton.Location = new Point(this.Width - 28, (this.Height - ClearButton.Height) / 2);
            }
        }

        protected override void OnMouseClick(MouseEventArgs e)
        {
            base.OnMouseClick(e);
            if (Input != null && !Input.Focused)
            {
                Input.Focus();
            }
        }

        protected override void OnPaint(PaintEventArgs e)
        {
            e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
            Color parentBg = Theme.GetSafeParentBackground(this, Theme.BgCard);
            using (SolidBrush pb = new SolidBrush(parentBg))
            {
                e.Graphics.FillRectangle(pb, ClientRectangle);
            }

            Rectangle rect = new Rectangle(0, 0, Width - 1, Height - 1);
            using (GraphicsPath path = Program.GetRoundedPath(rect, Radius))
            {
                using (SolidBrush bgBrush = new SolidBrush(this.BackColor))
                {
                    e.Graphics.FillPath(bgBrush, path);
                }

                Color borderColor = (Input != null && Input.Focused) ? Theme.BorderFocus : Theme.BorderMedium;
                float borderWidth = (Input != null && Input.Focused) ? 2f : 1.5f;

                using (Pen borderPen = new Pen(borderColor, borderWidth))
                {
                    e.Graphics.DrawPath(borderPen, path);
                }

                if (Input != null && Input.Focused)
                {
                    using (Pen glowPen = new Pen(Color.FromArgb(40, Theme.AccentPrimary), 2f))
                    {
                        Rectangle glowRect = new Rectangle(1, 1, Width - 3, Height - 3);
                        using (GraphicsPath glowPath = Program.GetRoundedPath(glowRect, Radius))
                        {
                            e.Graphics.DrawPath(glowPen, glowPath);
                        }
                    }
                }
            }

            int iconY = (this.Height - 16) / 2;
            using (Pen iconPen = new Pen(Theme.TextMuted, 1.6f))
            {
                e.Graphics.DrawEllipse(iconPen, 13, iconY + 1, 10, 10);
                e.Graphics.DrawLine(iconPen, 21, iconY + 10, 26, iconY + 15);
            }

            if (Input != null && string.IsNullOrEmpty(Input.Text) && !Input.Focused)
            {
                using (Font hintFont = new Font("Segoe UI", 9.5f, FontStyle.Italic))
                {
                    Rectangle hintRect = new Rectangle(38, (this.Height - 20) / 2, Width - 72, 20);
                    TextRenderer.DrawText(e.Graphics, Placeholder, hintFont, hintRect, Theme.TextDim,
                        TextFormatFlags.Left | TextFormatFlags.VerticalCenter | TextFormatFlags.EndEllipsis);
                }
            }
        }
    }

    #endregion

    public class MainForm : Form
    {
        private string originalLauncherPath = "";
        private string currentExeName = "";
        private string currentDisplayName = "";
        private bool isSimulatingMode = false;
        private bool isSwitchingProcesses = false;
        private Stopwatch sessionStopwatch;
        private System.Windows.Forms.Timer qualificationTrackerTimer;
        private NotifyIcon trayIcon;
        private ToolTip shelfToolTip;

        // 2-minute qualification flag
        private bool hasSaved2MinQualification = false;
        // Prevents double/triple recording of play time at stop+close
        private bool qualificationFinalRecorded = false;

        // UI Views
        private Panel pnlLauncher;
        private Panel pnlActive;

        // Launcher controls
        private SearchBox searchBox;
        private TextBox txtSearch;
        private CheckBox chkMinimizeToTray;
        private Panel pnlDropdown;
        private SearchResultsListBox listResults;
        private System.Windows.Forms.Timer debounceTimer;
        private GameItem selectedGame;
        private GameItem activeSimulatingGame;
        private PlayedGamesShelfControl shelfPlayedGames;
        private Label lblDatabaseStatus;
        private string startupGameArg = null;
        private bool isProgrammaticTextChange = false;

        // Selected Game Card Controls
        private ModernCard cardSelectedGame;
        private RoundedIconView picSelectedGameIcon;
        private Label lblSelectedGameTitle;
        private Label lblSelectedGameExe;
        private Label lblSelectedGameId;

        // Active controls
        private Label lblActiveGameTitle;
        private Label lblActiveProcessInfo;
        private Label lblSessionStartTime;
        private RoundedIconView picActiveGameIcon;
        private Label lblStreamHint;
        private Label lblActiveHeaderRight;
        private Label lblHookStatus;

        // Discord RPC Presence
        private DiscordRpcClient rpcClient;
        private Thread rpcThread;
        private volatile bool rpcRunning;
        private readonly object _rpcLock = new object();
        private int _rpcSessionId = 0;

        private void EnsureDatabaseInitialized()
        {
            if (GameDatabase.Instance.Count == 0 && !GameDatabase.Instance.IsUpdating)
            {
                GameDatabase.Instance.Initialize();
            }
        }

        public MainForm(string[] args)
        {
            shelfToolTip = new ToolTip();
            shelfToolTip.AutoPopDelay = 5000;
            shelfToolTip.InitialDelay = 300;
            shelfToolTip.ReshowDelay = 200;

            GameDatabase.Instance.OnDatabaseUpdated += OnDatabaseLoaded;
            GameDatabase.Instance.OnQualifiedGamesChanged += OnQualifiedGamesUpdated;

            InitializeCustomUI();

            string procName = Process.GetCurrentProcess().ProcessName;
            bool isRenamedBinary = !procName.Equals("GameLauncher", StringComparison.OrdinalIgnoreCase) &&
                                   !procName.Equals("DiscordQuestLauncher", StringComparison.OrdinalIgnoreCase) &&
                                   !procName.Equals("powershell", StringComparison.OrdinalIgnoreCase) &&
                                   !procName.Equals("pwsh", StringComparison.OrdinalIgnoreCase);

            if (args != null && args.Length >= 2 && args[0].Equals("--simulating", StringComparison.OrdinalIgnoreCase))
            {
                currentDisplayName = args[1];
                originalLauncherPath = args.Length >= 3 ? args[2] : "";
                if (args.Length >= 5)
                {
                    int x, y;
                    if (int.TryParse(args[3], out x) && int.TryParse(args[4], out y) && x > -5000 && y > -5000)
                    {
                        this.StartPosition = FormStartPosition.Manual;
                        this.Location = new Point(x, y);
                    }
                }
                if (args.Length >= 6)
                {
                    chkMinimizeToTray.Checked = (args[5] == "1");
                }
                currentExeName = args.Length >= 7 && !string.IsNullOrEmpty(args[6]) ? args[6] : Path.GetFileName(Application.ExecutablePath);

                string iconId = args.Length >= 8 ? args[7] : "";
                string iconHash = args.Length >= 9 ? args[8] : "";

                if (!string.IsNullOrEmpty(iconId))
                {
                    activeSimulatingGame = new GameItem { id = iconId, icon = iconHash, name = currentDisplayName, exe = currentExeName };
                }
                else
                {
                    EnsureDatabaseInitialized();
                    activeSimulatingGame = GameDatabase.Instance.FindExactGame(currentDisplayName) ?? GameDatabase.Instance.FindExactGame(currentExeName);
                }

                SwitchToActiveMode();
            }
            else if (args != null && args.Length >= 1 && args[0].Equals("--launcher", StringComparison.OrdinalIgnoreCase))
            {
                EnsureDatabaseInitialized();
                if (args.Length >= 3)
                {
                    int x, y;
                    if (int.TryParse(args[1], out x) && int.TryParse(args[2], out y) && x > -5000 && y > -5000)
                    {
                        this.StartPosition = FormStartPosition.Manual;
                        this.Location = new Point(x, y);
                    }
                }
                SwitchToLauncherMode();
            }
            else if (isRenamedBinary)
            {
                // Only auto-detect if running from our known dummy directories,
                // not from arbitrary locations (e.g. browser-renamed "GameLauncher (1).exe")
                string exePath = Application.ExecutablePath;
                string dummyDir = Path.Combine(Path.GetTempPath(), "DiscordDummyTools");
                bool isInDummyDir = exePath.StartsWith(dummyDir, StringComparison.OrdinalIgnoreCase);
                bool isInSteamCommon = exePath.IndexOf(Path.Combine("steamapps", "common"), StringComparison.OrdinalIgnoreCase) >= 0;

                if (isInDummyDir || isInSteamCommon)
                {
                    currentDisplayName = FormatDisplayName(procName);
                    currentExeName = Path.GetFileName(exePath);
                    originalLauncherPath = "";
                    EnsureDatabaseInitialized();
                    activeSimulatingGame = GameDatabase.Instance.FindExactGame(procName);
                    SwitchToActiveMode();
                }
                else
                {
                    EnsureDatabaseInitialized();
                    SwitchToLauncherMode();
                }
            }
            else if (args != null && args.Length >= 1 && !string.IsNullOrWhiteSpace(args[0]) && !args[0].StartsWith("--"))
            {
                EnsureDatabaseInitialized();
                startupGameArg = args[0];
                SwitchToLauncherMode();
            }
            else
            {
                EnsureDatabaseInitialized();
                SwitchToLauncherMode();
            }
        }

        private void OnDatabaseLoaded()
        {
            if (this.IsHandleCreated)
            {
                try
                {
                    this.BeginInvoke(new Action(() =>
                    {
                        if (lblDatabaseStatus != null)
                        {
                            lblDatabaseStatus.Text = string.Format("● {0:N0} Games Loaded", GameDatabase.Instance.Count);
                            lblDatabaseStatus.ForeColor = Theme.AccentGreen;
                        }
                    }));
                }
                catch { }
            }
        }

        private void OnQualifiedGamesUpdated()
        {
            if (this.IsHandleCreated)
            {
                try
                {
                    this.BeginInvoke(new Action(() => PopulatePlayedGamesShelf()));
                }
                catch { }
            }
        }

        protected override void OnHandleCreated(EventArgs e)
        {
            base.OnHandleCreated(e);
            Program.EnableImmersiveDarkMode(this.Handle);
        }

        protected override void OnShown(EventArgs e)
        {
            base.OnShown(e);
            string titleToSet = isSimulatingMode ? currentDisplayName : "Discord Quest Launcher";
            this.Text = titleToSet;
            Program.SetWindowText(this.Handle, titleToSet);

            if (!isSimulatingMode)
            {
                this.BeginInvoke(new Action(() =>
                {
                    if (txtSearch != null)
                    {
                        txtSearch.SelectionStart = txtSearch.Text.Length;
                        txtSearch.SelectionLength = 0;
                    }
                    if (shelfPlayedGames != null)
                    {
                        this.ActiveControl = shelfPlayedGames;
                    }
                }));
            }

            if (!string.IsNullOrEmpty(startupGameArg))
            {
                string arg = startupGameArg;
                startupGameArg = null;
                this.BeginInvoke(new Action(() =>
                {
                    GameItem found = GameDatabase.Instance.FindExactGame(arg);
                    if (found != null)
                    {
                        SelectGame(found);
                        LaunchSimulation(found.exe);
                    }
                    else
                    {
                        txtSearch.Text = arg;
                        LaunchSimulation(arg);
                    }
                }));
            }
        }

        private void InitializeCustomUI()
        {
            this.ClientSize = new Size(520, 560);
            this.FormBorderStyle = FormBorderStyle.FixedSingle;
            this.MaximizeBox = false;
            this.StartPosition = FormStartPosition.CenterScreen;
            this.BackColor = Theme.BgBase;
            this.ForeColor = Theme.TextPrimary;
            this.Icon = CreateAppIcon();

            // Rock-solid Tray Icon
            trayIcon = new NotifyIcon();
            trayIcon.Icon = this.Icon;
            trayIcon.Text = "Discord Quest Launcher";
            trayIcon.Visible = true;
            trayIcon.MouseClick += (s, e) =>
            {
                if (e.Button == MouseButtons.Left)
                {
                    RestoreFromTray();
                }
            };
            trayIcon.DoubleClick += (s, e) => RestoreFromTray();

            UpdateTrayContextMenu();

            // Background timer ONLY for tracking the 2-minute qualification threshold
            qualificationTrackerTimer = new System.Windows.Forms.Timer();
            qualificationTrackerTimer.Interval = 2000;
            qualificationTrackerTimer.Tick += OnQualificationTrackerTick;

            debounceTimer = new System.Windows.Forms.Timer();
            debounceTimer.Interval = 150;
            debounceTimer.Tick += OnDebounceTimerTick;

            BuildLauncherView();
            BuildActiveView();
        }

        private void UpdateTrayContextMenu()
        {
            if (trayIcon == null) return;
            ContextMenuStrip contextMenu = new ContextMenuStrip();
            contextMenu.BackColor = Theme.BgCard;
            contextMenu.ForeColor = Theme.TextPrimary;
            contextMenu.ShowImageMargin = false;

            if (isSimulatingMode)
            {
                ToolStripMenuItem showItem = new ToolStripMenuItem("Show " + currentDisplayName, null, (s, e) => RestoreFromTray());
                showItem.Font = new Font("Segoe UI", 9f, FontStyle.Bold);
                contextMenu.Items.Add(showItem);
                contextMenu.Items.Add("Stop Simulation", null, (s, e) => OnStopAndSwitchClicked(s, e));
                contextMenu.Items.Add(new ToolStripSeparator());
                contextMenu.Items.Add("Exit App", null, (s, e) => ExitApplication());
            }
            else
            {
                ToolStripMenuItem showItem = new ToolStripMenuItem("Show Launcher", null, (s, e) => RestoreFromTray());
                showItem.Font = new Font("Segoe UI", 9f, FontStyle.Bold);
                contextMenu.Items.Add(showItem);
                contextMenu.Items.Add(new ToolStripSeparator());
                contextMenu.Items.Add("Exit App", null, (s, e) => ExitApplication());
            }
            trayIcon.ContextMenuStrip = contextMenu;
        }

        private void BuildLauncherView()
        {
            pnlLauncher = new Panel();
            pnlLauncher.Dock = DockStyle.Fill;
            pnlLauncher.BackColor = Theme.BgBase;

            // Header Section
            HeaderBadge badge = new HeaderBadge("DISCORD QUEST LAUNCHER", Theme.AccentPrimary, Theme.AccentPurple, Color.White);
            badge.Location = new Point(16, 16);
            badge.Size = new Size(184, 24);
            pnlLauncher.Controls.Add(badge);

            lblDatabaseStatus = new Label();
            lblDatabaseStatus.UseMnemonic = false;
            lblDatabaseStatus.Text = string.Format("● {0:N0} Games Loaded", GameDatabase.Instance.Count);
            lblDatabaseStatus.Font = new Font("Segoe UI", 8f, FontStyle.Bold);
            lblDatabaseStatus.ForeColor = Theme.AccentGreen;
            lblDatabaseStatus.Location = new Point(260, 18);
            lblDatabaseStatus.Size = new Size(244, 20);
            lblDatabaseStatus.TextAlign = ContentAlignment.MiddleRight;
            lblDatabaseStatus.Cursor = Cursors.Hand;
            if (shelfToolTip != null)
            {
                shelfToolTip.SetToolTip(lblDatabaseStatus, "Click to refresh game database from Discord");
            }
            lblDatabaseStatus.Click += (s, e) =>
            {
                if (!GameDatabase.Instance.IsUpdating)
                {
                    lblDatabaseStatus.Text = "● Updating Database...";
                    lblDatabaseStatus.ForeColor = Theme.AccentCyan;
                    GameDatabase.Instance.RefreshFromDiscordAsync();
                }
            };
            pnlLauncher.Controls.Add(lblDatabaseStatus);

            Label lblTitle = new Label();
            lblTitle.UseMnemonic = false;
            lblTitle.Text = "Game Presence Simulator";
            lblTitle.Font = new Font("Segoe UI", 16f, FontStyle.Bold);
            lblTitle.ForeColor = Theme.TextBright;
            lblTitle.Location = new Point(14, 44);
            lblTitle.Size = new Size(490, 28);
            pnlLauncher.Controls.Add(lblTitle);

            Label lblSubtitle = new Label();
            lblSubtitle.UseMnemonic = false;
            lblSubtitle.Text = "Select a game to spoof your Discord active playing status";
            lblSubtitle.Font = new Font("Segoe UI", 8.5f, FontStyle.Regular);
            lblSubtitle.ForeColor = Theme.TextMuted;
            lblSubtitle.Location = new Point(16, 72);
            lblSubtitle.Size = new Size(490, 18);
            pnlLauncher.Controls.Add(lblSubtitle);

            // Main Card
            ModernCard card = new ModernCard();
            card.Location = new Point(16, 96);
            card.Size = new Size(488, 440);
            card.BackColor = Theme.BgCard;
            card.BorderColor = Theme.BorderSubtle;
            card.Radius = 14;
            card.ShowTopAccent = true;
            card.AccentColor1 = Theme.AccentPrimary;
            card.AccentColor2 = Theme.AccentPurple;

            SectionLabel lblSearchHeader = new SectionLabel("SEARCH GAME DATABASE");
            lblSearchHeader.Location = new Point(16, 14);
            card.Controls.Add(lblSearchHeader);

            ModernButton btnAddCustom = new ModernButton();
            btnAddCustom.Text = "+ Add Custom";
            btnAddCustom.Location = new Point(348, 8);
            btnAddCustom.Size = new Size(124, 22);
            btnAddCustom.Font = new Font("Segoe UI", 8f, FontStyle.Bold);
            btnAddCustom.NormalColor1 = Theme.BgElevated;
            btnAddCustom.NormalColor2 = Color.FromArgb(50, 52, 70);
            btnAddCustom.HoverColor1 = Theme.AccentPrimary;
            btnAddCustom.HoverColor2 = Theme.AccentPurple;
            btnAddCustom.BorderRadius = 6;
            btnAddCustom.Click += (s, e) => ShowAddCustomGameDialog(txtSearch != null ? txtSearch.Text : "");
            card.Controls.Add(btnAddCustom);

            // Resolve initial selected game (last simulated game, or fallback)
            GameItem initialGame = GameDatabase.Instance.GetLastSimulatedGame();
            if (initialGame == null)
            {
                initialGame = new GameItem
                {
                    id = "1437509662303059998",
                    name = "Where Winds Meet",
                    icon = "54b48542501564ce5e9837f7fa3171a5",
                    exe = "where winds meet.exe"
                };
            }
            else if (string.IsNullOrEmpty(initialGame.id) || string.IsNullOrEmpty(initialGame.icon))
            {
                GameItem found = GameDatabase.Instance.FindExactGame(initialGame.name) ?? GameDatabase.Instance.FindExactGame(initialGame.exe);
                if (found != null)
                {
                    initialGame = found;
                }
            }

            // Search input container
            searchBox = new SearchBox();
            searchBox.Location = new Point(16, 34);
            searchBox.Size = new Size(456, 42);
            txtSearch = searchBox.Input;
            txtSearch.Text = initialGame.name;

            searchBox.ClearButton.Click += (s, e) =>
            {
                txtSearch.Text = "";
                txtSearch.Focus();
                pnlDropdown.Visible = false;
            };

            txtSearch.TextChanged += (s, e) =>
            {
                if (isProgrammaticTextChange)
                {
                    debounceTimer.Stop();
                    pnlDropdown.Visible = false;
                    return;
                }

                debounceTimer.Stop();
                debounceTimer.Start();
            };

            txtSearch.Enter += (s, e) =>
            {
                this.BeginInvoke(new Action(() =>
                {
                    if (txtSearch != null && txtSearch.SelectionLength > 0)
                    {
                        txtSearch.SelectionStart = txtSearch.Text.Length;
                        txtSearch.SelectionLength = 0;
                    }
                }));
            };

            txtSearch.KeyDown += (s, e) =>
            {
                if (e.KeyCode == Keys.Down)
                {
                    if (pnlDropdown.Visible && listResults.Items.Count > 0)
                    {
                        int next = listResults.SelectedIndex + 1;
                        if (next < listResults.Items.Count) listResults.SelectedIndex = next;
                        else listResults.SelectedIndex = 0;
                        e.Handled = true;
                        e.SuppressKeyPress = true;
                    }
                    else if (!pnlDropdown.Visible && listResults.Items.Count > 0)
                    {
                        pnlDropdown.Visible = true;
                        pnlDropdown.BringToFront();
                        e.Handled = true;
                        e.SuppressKeyPress = true;
                    }
                }
                else if (e.KeyCode == Keys.Up)
                {
                    if (pnlDropdown.Visible && listResults.Items.Count > 0)
                    {
                        int prev = listResults.SelectedIndex - 1;
                        if (prev >= 0) listResults.SelectedIndex = prev;
                        else listResults.SelectedIndex = listResults.Items.Count - 1;
                        e.Handled = true;
                        e.SuppressKeyPress = true;
                    }
                }
                else if (e.KeyCode == Keys.Enter)
                {
                    e.SuppressKeyPress = true;
                    GameItem selected = listResults.SelectedItem as GameItem;
                    if (pnlDropdown.Visible && selected != null)
                    {
                        pnlDropdown.Visible = false;
                        if (selected.id == "__ADD_CUSTOM__")
                        {
                            ShowAddCustomGameDialog(txtSearch.Text);
                        }
                        else
                        {
                            SelectGame(selected);
                            LaunchSimulation(selected.exe);
                        }
                    }
                    else
                    {
                        pnlDropdown.Visible = false;
                        string text = txtSearch.Text.Trim();
                        if (selectedGame != null && selectedGame.id != "__ADD_CUSTOM__" &&
                            (string.IsNullOrEmpty(text) || string.Equals(selectedGame.name, text, StringComparison.OrdinalIgnoreCase)))
                        {
                            LaunchSimulation(selectedGame.exe);
                        }
                        else
                        {
                            LaunchSimulation(text);
                        }
                    }
                }
                else if (e.KeyCode == Keys.Escape)
                {
                    pnlDropdown.Visible = false;
                    e.Handled = true;
                    e.SuppressKeyPress = true;
                }
            };

            card.Controls.Add(searchBox);

            // Played Games Section (ONLY games run for >= 2 minutes)
            SectionLabel lblShelfHeader = new SectionLabel("PLAYED GAMES (2+ MINS)");
            lblShelfHeader.Location = new Point(16, 88);
            card.Controls.Add(lblShelfHeader);

            shelfPlayedGames = new PlayedGamesShelfControl();
            shelfPlayedGames.Location = new Point(16, 108);
            shelfPlayedGames.Size = new Size(456, 54);
            shelfPlayedGames.GameSelected += (game) => SelectGame(game);
            card.Controls.Add(shelfPlayedGames);

            PopulatePlayedGamesShelf();

            // Selected Game Hero Card
            SectionLabel lblSelectedHeader = new SectionLabel("SELECTED GAME");
            lblSelectedHeader.Location = new Point(16, 172);
            card.Controls.Add(lblSelectedHeader);

            cardSelectedGame = new ModernCard();
            cardSelectedGame.Location = new Point(16, 192);
            cardSelectedGame.Size = new Size(456, 86);
            cardSelectedGame.BackColor = Theme.BgElevated;
            cardSelectedGame.BorderColor = Color.FromArgb(40, 88, 101, 242);
            cardSelectedGame.Radius = 12;
            cardSelectedGame.ShowTopAccent = true;
            cardSelectedGame.AccentColor1 = Theme.AccentPrimary;
            cardSelectedGame.AccentColor2 = Theme.AccentPurple;

            picSelectedGameIcon = new RoundedIconView(12);
            picSelectedGameIcon.Location = new Point(14, 14);
            picSelectedGameIcon.Size = new Size(58, 58);
            cardSelectedGame.Controls.Add(picSelectedGameIcon);

            lblSelectedGameTitle = new Label();
            lblSelectedGameTitle.UseMnemonic = false;
            lblSelectedGameTitle.Text = initialGame.name;
            lblSelectedGameTitle.Font = new Font("Segoe UI", 12f, FontStyle.Bold);
            lblSelectedGameTitle.ForeColor = Theme.TextBright;
            lblSelectedGameTitle.Location = new Point(84, 13);
            lblSelectedGameTitle.Size = new Size(356, 22);
            cardSelectedGame.Controls.Add(lblSelectedGameTitle);

            lblSelectedGameExe = new Label();
            lblSelectedGameExe.UseMnemonic = false;
            lblSelectedGameExe.Text = "Target .exe: " + initialGame.exe;
            lblSelectedGameExe.Font = new Font("Consolas", 8.5f, FontStyle.Regular);
            lblSelectedGameExe.ForeColor = Theme.AccentGreen;
            lblSelectedGameExe.Location = new Point(84, 37);
            lblSelectedGameExe.Size = new Size(356, 18);
            cardSelectedGame.Controls.Add(lblSelectedGameExe);

            lblSelectedGameId = new Label();
            lblSelectedGameId.UseMnemonic = false;
            lblSelectedGameId.Text = string.IsNullOrEmpty(initialGame.id) ? "" : "Discord App ID: " + initialGame.id;
            lblSelectedGameId.Font = new Font("Segoe UI", 7.5f, FontStyle.Regular);
            lblSelectedGameId.ForeColor = Theme.TextDim;
            lblSelectedGameId.Location = new Point(84, 57);
            lblSelectedGameId.Size = new Size(356, 16);
            cardSelectedGame.Controls.Add(lblSelectedGameId);

            card.Controls.Add(cardSelectedGame);

            // Launch Action Button (Full width, gradient with shimmer animation, no redundant icon)
            ModernButton btnStart = new ModernButton();
            btnStart.Text = "▶   Launch Game Simulation";
            btnStart.Location = new Point(16, 290);
            btnStart.Size = new Size(456, 50);
            btnStart.Font = new Font("Segoe UI", 11.5f, FontStyle.Bold);
            btnStart.NormalColor1 = Theme.AccentPrimary;
            btnStart.NormalColor2 = Theme.AccentPurple;
            btnStart.BorderRadius = 12;
            btnStart.ShowShimmer = true;
            btnStart.StartShimmer();
            btnStart.Click += (s, e) =>
            {
                pnlDropdown.Visible = false;
                string text = txtSearch != null ? txtSearch.Text.Trim() : "";
                if (selectedGame != null && selectedGame.id != "__ADD_CUSTOM__" &&
                    (string.IsNullOrEmpty(text) || string.Equals(selectedGame.name, text, StringComparison.OrdinalIgnoreCase)))
                {
                    LaunchSimulation(selectedGame.exe);
                }
                else
                {
                    LaunchSimulation(text);
                }
            };
            card.Controls.Add(btnStart);

            // Tray Checkbox and Footer notes
            chkMinimizeToTray = new CheckBox();
            chkMinimizeToTray.Text = "Minimize to system tray on close";
            chkMinimizeToTray.Font = new Font("Segoe UI", 8.5f, FontStyle.Regular);
            chkMinimizeToTray.ForeColor = Theme.TextSecondary;
            chkMinimizeToTray.Location = new Point(16, 352);
            chkMinimizeToTray.AutoSize = true;
            chkMinimizeToTray.Cursor = Cursors.Hand;
            chkMinimizeToTray.Checked = true;
            if (shelfToolTip != null)
            {
                shelfToolTip.SetToolTip(chkMinimizeToTray, "When checked, pressing Close (X) sends the app to the system tray. Pressing Minimize (_) minimizes to the taskbar.");
            }
            card.Controls.Add(chkMinimizeToTray);

            Label lblCardFooter = new Label();
            lblCardFooter.UseMnemonic = false;
            lblCardFooter.Text = "Runs continuously until closed. Stream this window in Discord for stream quests.";
            lblCardFooter.Font = new Font("Segoe UI", 7.5f, FontStyle.Regular);
            lblCardFooter.ForeColor = Theme.TextDim;
            lblCardFooter.Location = new Point(16, 384);
            lblCardFooter.Size = new Size(456, 28);
            card.Controls.Add(lblCardFooter);

            // Floating Dropdown Overlay Panel
            pnlDropdown = new Panel();
            pnlDropdown.Location = new Point(16, 78);
            pnlDropdown.Size = new Size(456, 210);
            pnlDropdown.BackColor = Theme.BgInput;
            pnlDropdown.Visible = false;
            pnlDropdown.Paint += (s, e) =>
            {
                e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
                Rectangle r = new Rectangle(0, 0, pnlDropdown.Width - 1, pnlDropdown.Height - 1);
                using (GraphicsPath p = Program.GetRoundedPath(r, 8))
                {
                    using (Pen pen = new Pen(Theme.AccentPrimary, 1.5f))
                    {
                        e.Graphics.DrawPath(pen, p);
                    }
                }
            };

            listResults = new SearchResultsListBox();
            listResults.Dock = DockStyle.Fill;
            listResults.MouseClick += (s, e) =>
            {
                int idx = listResults.IndexFromPoint(e.Location);
                if (idx >= 0 && idx < listResults.Items.Count)
                {
                    GameItem selected = listResults.Items[idx] as GameItem;
                    if (selected != null)
                    {
                        pnlDropdown.Visible = false;
                        if (selected.id == "__ADD_CUSTOM__")
                        {
                            ShowAddCustomGameDialog(txtSearch.Text);
                        }
                        else
                        {
                            SelectGame(selected);
                        }
                    }
                }
            };
            listResults.Click += (s, e) =>
            {
                GameItem selected = listResults.SelectedItem as GameItem;
                if (selected != null)
                {
                    pnlDropdown.Visible = false;
                    if (selected.id == "__ADD_CUSTOM__")
                    {
                        ShowAddCustomGameDialog(txtSearch.Text);
                    }
                    else
                    {
                        SelectGame(selected);
                    }
                }
            };
            listResults.DoubleClick += (s, e) =>
            {
                GameItem selected = listResults.SelectedItem as GameItem;
                if (selected != null)
                {
                    pnlDropdown.Visible = false;
                    if (selected.id == "__ADD_CUSTOM__")
                    {
                        ShowAddCustomGameDialog(txtSearch.Text);
                    }
                    else
                    {
                        SelectGame(selected);
                    }
                }
            };
            pnlDropdown.Controls.Add(listResults);
            card.Controls.Add(pnlDropdown);
            pnlDropdown.BringToFront();

            pnlLauncher.Controls.Add(card);

            Control[] dismissers = new Control[] { card, pnlLauncher, lblSearchHeader, shelfPlayedGames, cardSelectedGame, btnStart, chkMinimizeToTray, badge, lblTitle, lblSubtitle, lblShelfHeader, lblSelectedHeader, lblCardFooter };
            foreach (Control c in dismissers)
            {
                c.Click += (s, e) => { pnlDropdown.Visible = false; };
            }

            // Set initial selected game
            SelectGame(initialGame);

            this.Controls.Add(pnlLauncher);
        }

        private void PopulatePlayedGamesShelf()
        {
            if (shelfPlayedGames != null)
            {
                shelfPlayedGames.SetGames(GameDatabase.Instance.GetQualifiedGames());
            }
        }

        private void OnDebounceTimerTick(object sender, EventArgs e)
        {
            debounceTimer.Stop();
            if (isProgrammaticTextChange)
            {
                pnlDropdown.Visible = false;
                return;
            }

            string rawQuery = txtSearch.Text.Trim();
            if (string.IsNullOrEmpty(rawQuery))
            {
                pnlDropdown.Visible = false;
                return;
            }

            string cleanQuery = GameDatabase.CleanSearchQuery(rawQuery);
            List<GameItem> matches = GameDatabase.Instance.Search(rawQuery, 40);
            listResults.BeginUpdate();
            listResults.Items.Clear();

            foreach (var g in matches)
            {
                listResults.Items.Add(g);
            }

            bool hasExact = false;
            for (int i = 0; i < matches.Count; i++)
            {
                string name = matches[i].name ?? "";
                if (string.Equals(name, rawQuery, StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(name, cleanQuery, StringComparison.OrdinalIgnoreCase) ||
                    GameDatabase.NormalizeString(name) == GameDatabase.NormalizeString(rawQuery) ||
                    GameDatabase.NormalizeString(name) == GameDatabase.NormalizeString(cleanQuery))
                {
                    hasExact = true;
                    break;
                }
            }

            if (!hasExact && matches.Count > 0 && matches[0] != null)
            {
                List<string> aliases = GameDatabase.ExpandAliases(rawQuery.ToLowerInvariant());
                if (aliases.Contains((matches[0].name ?? "").ToLowerInvariant()))
                {
                    hasExact = true;
                }
            }

            if (!hasExact && !string.IsNullOrWhiteSpace(rawQuery))
            {
                string inferred = GameDatabase.InferExecutableFromName(cleanQuery.Length > 0 ? cleanQuery : rawQuery);
                listResults.Items.Add(new GameItem
                {
                    id = "__ADD_CUSTOM__",
                    name = "+ Add \"" + rawQuery + "\" as Custom Game...",
                    exe = "Inferred: " + inferred,
                    icon = ""
                });
            }

            listResults.EndUpdate();

            if (listResults.Items.Count > 0)
            {
                listResults.SelectedIndex = 0;
                pnlDropdown.Visible = true;
                pnlDropdown.BringToFront();
            }
            else
            {
                pnlDropdown.Visible = false;
            }
        }

        private void SelectGame(GameItem game)
        {
            if (game == null || game.id == "__ADD_CUSTOM__") return;
            selectedGame = game;

            isProgrammaticTextChange = true;
            try
            {
                debounceTimer.Stop();
                pnlDropdown.Visible = false;
                txtSearch.Text = game.name;
                txtSearch.SelectionStart = txtSearch.Text.Length;
                txtSearch.SelectionLength = 0;
            }
            finally
            {
                isProgrammaticTextChange = false;
            }

            lblSelectedGameTitle.Text = game.name;
            lblSelectedGameExe.Text = "Target .exe: " + game.exe;
            lblSelectedGameId.Text = string.IsNullOrEmpty(game.id) ? "" : "Discord App ID: " + game.id;

            GameItem capturedGame = selectedGame;
            Image icon58 = IconCache.Instance.GetIcon(game, 58, (loaded) =>
            {
                if (this.IsHandleCreated)
                {
                    try
                    {
                        this.BeginInvoke(new Action(() =>
                        {
                            // Only apply if this is still the selected game
                            if (selectedGame == capturedGame)
                            {
                                picSelectedGameIcon.Image = loaded;
                            }
                        }));
                    }
                    catch { }
                }
            });

            picSelectedGameIcon.Image = icon58;
        }

